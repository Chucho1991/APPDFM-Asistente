  FUNCTION Arma_Trama_Re(p_Trama_Re IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Re) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Timespan
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Re.Timespan
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Ack
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Ack
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Nack
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Nack
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Con_Servicio
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Con_Servicio
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Sin_Servicio
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Sin_Servicio
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Timeout
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Timeout
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Re.Rx_Erronea
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Re.Rx_Erronea
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'RE';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

