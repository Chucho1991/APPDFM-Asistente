                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp.Lista_Grupos
                                                               ,0)
                                                           ,l_Largo));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Dp2(p_Trama_Dp.Subtrama_Dp2));
    END IF;
  
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'DP';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Dp1(p_Trama_Dp1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dp1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dp1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Largo     := Lengthb(Nvl(p_Trama_Dp1(l_Item).Atributo
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp1(l_Item).Atributo
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  --//--------------------------------------------------------------------------\\
  --// CBR 13/11/2017 18:25 GEOLOYALTY                                          \\
  --//                                                                          \\
  --//-----------------------------------------------------------------Inicio---\\
  FUNCTION Arma_Trama_Dp2(p_Trama_Dp2 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dp2) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dp2.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Id
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp2(l_Item).Id
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Id_Grupo
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp2(l_Item).Id_Grupo
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Nombre_Grupo
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp2(l_Item).Nombre_Grupo
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Valor_Grupo
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp2(l_Item).Valor_Grupo
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Fecha_Creacion
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
