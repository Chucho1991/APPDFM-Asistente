  /* ========== */
  /*  TRAMA RO1 */
  /* ========== */
  FUNCTION Arma_Trama_Ro1(p_Trama_Ro1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ro1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ro1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      IF Nvl(p_Version
            ,'POS') IN ('OTN'
                       ,'SAP') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ro1(l_Item).Numero_Orden_Trabajo
                                                                         ,' ')
                                                                     ,14
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ro1(l_Item).Numero_Orden_Trabajo
                                                                         ,' ')
                                                                     ,13
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ro1(l_Item).Total_Envases
                                                                ,0)
                                                            ,1));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

