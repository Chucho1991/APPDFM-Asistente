  FUNCTION Arma_Trama_Hc(p_Trama_Hc IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Hc
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Hc.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Codigo_Producto_Interno
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Fecha
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Decimal_Cantidad
                                                                 ,0)
                                                             ,4));
      END IF;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                   
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Numero_Consejo
                                                               ,0)
                                                           ,8));
      IF Nvl(p_Version
            ,'POS') IN ('CTG'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Id_Grupo
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hc(l_Item).Saldo_Grupo
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Hc(l_Item).Nombre_Grupo
                                                                         ,' ')
                                                                     ,60
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'HC';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Co(p_Trama_Co IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Co
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Co.Count;    
        
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Convenio
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co(l_Item).Convenio
                                                               ,0)
                                                           ,l_Largo));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Plan
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co(l_Item).Plan
                                                               ,0)
                                                           ,l_Largo));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Estado_Convenio
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Estado_Convenio
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Retencion
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Retencion
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Aplica_Dcto_Posologia
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Aplica_Dcto_Posologia
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Agrupacion_Perfil
                               ,'   '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Agrupacion_Perfil
                                                                       ,'   ')
                                                                   ,l_Largo
                                                                   ,'   ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Prioridad_Ges
                               ,'   '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Prioridad_Ges
                                                                       ,'   ')
                                                                   ,l_Largo
                                                                   ,'   ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Dias_Tto_Defecto
                               ,0));
    
      IF l_Largo <= 2 THEN
        l_Largo := 1;
      ELSIF l_Largo >= 3 THEN
        l_Largo := 2;
      END IF;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co(l_Item).Dias_Tto_Defecto
                                                               ,0)
                                                           ,l_Largo));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Receta_Retenida
                               ,'   '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Receta_Retenida
                                                                       ,'   ')
                                                                   ,l_Largo
                                                                   ,'   ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Requiere_Indicaciones
                               ,'   '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Requiere_Indicaciones
                                                                       ,'   ')
                                                                   ,l_Largo
                                                                   ,'   ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Imprime_Indicaciones
                               ,'   '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Imprime_Indicaciones
                                                                       ,'   ')
                                                                   ,l_Largo
                                                                   ,'   ')
                                                              ,'WE8MSWIN1252')));
      --//--------------------------------------------------------------------------\\
      --// CBR 09/29/2016 12:05PM                                                   \\
      --// Nuevo campo REQUIERE_CONTRASENA_QF origen transaccion SQF                \\
      --//-----------------------------------------------------------------Inicio---\\
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Solicitar_Clave_Qf
                               ,'  '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Solicitar_Clave_Qf
                                                                       ,'  ')
                                                                   ,l_Largo
                                                                   ,'  ')
                                                              ,'WE8MSWIN1252')));
      --//--------------------------------------------------------------------------\\
      --// CBR 03/06/2016 17:04                                                     \\
      --// CLUB COMO CONVENIO                                                       \\
      --//-----------------------------------------------------------------Inicio---\\
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Despliegue_Rechazo
                               ,'  '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Despliegue_Rechazo
                                                                       ,'  ')
                                                                   ,l_Largo
                                                                   ,'  ')
                                                              ,'WE8MSWIN1252')));
      --//--------------------------------------------------------------------------\\
      --// CBR 22/12/2017 17:21  BOX AHORRO                                         \\
      --//-----------------------------------------------------------------Inicio---\\
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Glosa_Descuento
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Glosa_Descuento
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Convenio_Club
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Convenio_Club
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      /* CGC 25-10-2018 INI */
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'CPE'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
      
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Digitalizacion
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Digitalizacion
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      /* CGC 25-10-2018 FIN */
      /* -- JRG CIA 04/06/219 */
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'CPE'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Plan_Con_Guia
                                 ,'  '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Plan_Con_Guia
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        /*
                l_Registro := Utl_Raw.Concat(l_Registro
                                            ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(RPAD(p_Trama_Co(l_Item).plan_con_guia,3,' ')
                                                                                 ,'   ')
                                                                             ,l_Largo
                                                                             ,'   ')
                                                                        ,'WE8MSWIN1252')));
        */
      END IF; --    IF Nvl(p_Version ,'POS') IN ('CIA') THEN
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('PEX'
                       ,'EC1'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Plan_Alternativo
                                 ,'  '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Plan_Alternativo
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
      END IF;
      --//--------------------------------------------------------------------------\\
      --// LMP 4/2023 Ecuador                                                       \\
      --// origen trx SAL                                                      \\
      --//-----------------------------------------------------------------Inicio---\\
      IF Nvl(p_Version
            ,'POS') IN ('SAL'
                  ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                  ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                  ,'NEU','ONS' ,'OBE' --JAGC 20261022
                  ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
      ) THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Tipo_Plan
                                 ,'  '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Tipo_Plan
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Item_Fee
                                 ,'  '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Item_Fee
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Marca_Fee
                                 ,'  '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co(l_Item).Marca_Fee
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
    
      l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Lista_Beneficiarios
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co(l_Item).Lista_Beneficiarios
                                                               ,0)
                                                           ,l_Largo));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Co1(p_Trama_Co(l_Item).Subtrama_Co1
                                                 ,p_Version));
      --//--------------------------------------------------------------------------\\
      --// LMP 4/2023 Ecuador                                                       \\
      --// origen trx SAL                                                      \\
      --//-----------------------------------------------------------------Inicio---\\
      IF Nvl(p_Version
            ,'POS') IN ('PEX'
                       ,'EC1'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
      
        l_Largo    := Lengthb(Nvl(p_Trama_Co(l_Item).Lista_Preexistencia
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co(l_Item).Lista_Preexistencia
                                                                 ,0)
                                                             ,l_Largo));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Arma_Trama_Co2(p_Trama_Co(l_Item).Subtrama_Co2
                                                   ,p_Version));
      END IF;
      l_Registro := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                           ,2)
                                  ,l_Registro);
    
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
        
    l_Trama_Htx.Tipo_Informacion   := 'CO';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  -- gncc02 --
  FUNCTION Arma_Trama_Db(p_Trama_Db IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Db
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Db.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
    
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Db(l_Item).Identi_Beneficiario
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Identi_Beneficiario
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Largo    := Lengthb(Nvl(p_Trama_Db(l_Item).Rut_Beneficiario
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Db(l_Item).Rut_Beneficiario
                                                                 ,0)
                                                             ,l_Largo));
        l_Largo    := Lengthb(Nvl(p_Trama_Db(l_Item).Dv_Rut_Beneficiario
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Dv_Rut_Beneficiario
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      IF Nvl(p_Version
            ,'POS') IN ('SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
      
        l_Largo    := Lengthb(Nvl(p_Trama_Db(l_Item).Party_Id_c
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Party_Id_c
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Largo    := Lengthb(Nvl(p_Trama_Db(l_Item).Party_Id
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Db(l_Item).Party_Id
                                                                 ,0)
                                                             ,l_Largo));
      END IF;
    
      l_Largo     := Lengthb(Nvl(p_Trama_Db(l_Item).Secuencia_b
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Db(l_Item).Secuencia_b
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Db(l_Item).Apellido_Paterno
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Apellido_Paterno
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Db(l_Item).Apellido_Materno
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Apellido_Materno
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Db(l_Item).Nombre
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Db(l_Item).Nombre
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'DB';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Cv(p_Trama_Cv IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Cv
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Cv.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cv(l_Item).Convenio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cv(l_Item).Plan
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Codigo_Autorizacion
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM' 
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Identi_Titular
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cv(l_Item).Rut_Titular
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Dv_Titular
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      IF Nvl(p_Version
            ,'POS') IN ('ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Identificacion_Comprador
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Codigo_Autorizacion_Externo
                                                                         ,' ')
                                                                     ,20
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      IF Nvl(p_Version
            ,'POS') IN ('SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv(l_Item).Party_Id_c
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cv(l_Item).Party_Id
                                                                 ,0)
                                                             ,7));
      END IF;
    
      IF Nvl(p_Version
            ,'POS') IN ('ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cv(l_Item).Lista_Diagnosticos
                                                                 ,0)
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Arma_Trama_Cv1(p_Trama_Cv(l_Item).Subtrama_Cv1));
      
      END IF;
    
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'CV';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Cv1(p_Trama_Cv1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Cv1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Cv1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cv1(l_Item).Diagnostico
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Dv(p_Trama_Dv IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Dv
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Correlativo_Tx
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tipo_Tx
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Fecha
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Hora_Venta
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Numero_Cotizacion
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Pin_Transaccion
                                                                     ,' ')
                                                                 ,10
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Numero_Preventa
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                                                                                                                                                                                 ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Correlativo_Tx_Asociado
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Local
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Codigo_Agente_Desp_Domicilio
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Rut_Agente_Despacho_Domicilio
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Dv_Rut_Agente_Desp_Domicilio
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Numero_Service_Request_Ddo
                                                             ,0)
                                                         ,8));
  
    --//--------------------------------------------------------------------------\\
    --// CBR 10/01/2019 12:00                                                     \\
    --// a estas alturas del partido, todos los codigos de barra deben ser de 14  \\
    --//-----------------------------------------------------------------Inicio---\\
    --  IF Nvl(p_Version,'POS') IN ('OTN','ETV','SQF','CCV') THEN
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Ot
                                                                     ,' ')
                                                                 ,14
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    --  ELSE
    --    l_Registro := Utl_Raw.Concat(l_Registro,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Ot,' '),13,' '),'WE8MSWIN1252')));
    --  END IF;
    --//-----------------------------------------------------------------Termino--\\
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Recaudacion_Relacionada
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Cuadra_Transaccion
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Documento_Liquidacion_Pago
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Documento_Liquidacion_Empresa
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Codigo_Autorizacion_Externo
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Rut_Empresa
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Transaccion_Manual
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Movimiento_Enlinea
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Supervisor
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Rut_Supervisor
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tipo_Deducible
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Monto_Deducible
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Valor_Moneda
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tipo_Moneda
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Numero_Liquidacion
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Indicadores_Tx
                                                                     ,' ')
                                                                 ,50
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- IF Nvl(p_Version,'POS') IN ('DTE','PRM','FEC','FJC','PRE','MAG','FFR','SGN','OTN','CCR','ISP','COR','SQF','CCV','BOX','GLO','FEL') THEN  -- *** DESARROLLO ANTIGUO ***
    -- erika 29112018
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Documento_Electronico
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- END IF;
    -- IF Nvl(p_Version,'POS') IN ('FEC','FJC','PRE','MAG','FFR','SGN','OTN','CCR','ISP','COR','BOX','GLO','FEL') THEN  -- *** DESARROLLO ANTIGUO ***
    --erika 29112018
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Fecha_Inicio_Tx
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Fecha_Cierre_Tx
                                                             ,0)
                                                         ,8));
    -- END IF;
    IF Nvl(p_Version
          ,'POS') IN ('FAT'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Factura_Turista
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Tipo_Documento_Id
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Numero_Documento_Id
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('DEC'
                     ,'ABF'
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tipo_Facturacion
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    
    --INI JAGC 20240909 NECESIDADES 'NEC'  
    IF Nvl(p_Version
          ,'POS') IN (
                'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
               ,'NEU','ONS' ,'OBE' --JAGC 20261022
               ) THEN
               
         
    
         l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Nombre_Cliente_Factura
                                                                       ,' ')
                                                                   ,100
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));      
    
         l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Tiene_Donacion
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
         --l_Registro := Utl_Raw.Concat(l_Registro
         --                         ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Folio_venta_Anulada
         --                                                      ,0)
         --                                                  ,8)); 
         l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Folio_venta_Anulada
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));                                                    
      
         l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv.Canal
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
    END IF;
    --FIN JAGC 20240909 NECESIDADES 'NEC'
    
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Documentos_Emitidos
                                                                                 ,0)
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Dv1(p_Trama_Dv.Subtrama_Dv1
                                                                   ,p_Version));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv.Tx_Relacionadas
                                                                                 ,0)
                                                                             ,1));
                                                                        
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Dv2(p_Trama_Dv.Subtrama_Dv2));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'DV';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Dv2(p_Trama_Dv2 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dv2) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dv2.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv2(l_Item).Correlativo_Tx
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv2(l_Item).Motivo
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Dv1(p_Trama_Dv1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dv1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dv1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Secuencia_b
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Tipo_Movimiento_Hijo
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Numero_Asignacion
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Anulado
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Folio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Tipo_Dicc
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Folio_Dicc
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Total_Iva_Incluido
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Iva
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Puntos_Asignados
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Tipo_Distribucion
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Campana
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Secuencia_Financiamiento
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Documento_Fiscal
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Afecto
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Exento
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('FFR'
                       ,'SGN'
                       ,'OTN'
                       ,'CCR'
                       ,'ISP'
                       ,'COR'
                       ,'BOX'
                       ,'GLO'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dv1(l_Item).Periodo_Facturacion
                                                                 ,0)
                                                             ,3));
      END IF;
      /* -- JRG CIA 04/06/219 */
      IF Nvl(p_Version
            ,'POS') IN ('CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dv1(l_Item).Tipo_Guia_Emitida
                                                                         ,'  ')
                                                                     ,3
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
      END IF; --       IF Nvl(p_Version ,'POS') IN ('CIA') THEN
      /* -- FIN JRG CIA 04/06/219 */
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pm(p_Trama_Pm IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pm
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pm.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Producto
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Codigo_Barra
                                                               ,0)
                                                           ,6));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Uso_Frecuente
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Precio_Lista
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Decimal_Plista
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Precio_Final
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Decimal_Pfinal
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Costo_Unitario
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Decimal_Cunitario
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Decimal_Cantidad
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Cantidad_Acumulada_Psalud
                                                               ,0)
                                                           ,2));
    
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Identi_Vendedor
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Rut_Vendedor
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Dv_Rut_Vendedor
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Codigo_Autorizacion
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Aplicacion_Item
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Accion_Sobre_Existencia
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Saldo_Compra_Frecuente
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Acumulador_Entrega
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Numero_Consejo
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Porcentaje_Bonificacion
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Cantidad_Canjeada
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Canje_Transaccion_Origen
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Canje_Local_Origen
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Inscrito_Programa_Salud
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Permitido_Por_Convenio
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Campana_Promocion
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Campana_Aditiva
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Beneficio_Pendiente_Ps
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Exento_Iva
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Controla_Stock
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Permite_Devolucion
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Producto_Original_Demandado
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Secuencia_Receta_Relacionada
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Porcentaje_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Monto_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Deducible_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Tope_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Identi_Supervisor
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Rut_Supervisor
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Dv_Rut_Supervisor
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      
      --INI JAGC 20240909 NECESIDADES 'NEC'  
      IF Nvl(p_Version
            ,'POS') IN (
                  'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                 ,'NEU','ONS' ,'OBE' --JAGC 20261022
                 ) THEN
        
           l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm(l_Item).Nombre_Vendedor
                                                                           ,' ')
                                                                       ,30
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
      
      END IF;
      --FIN JAGC 20240909 NECESIDADES 'NEC'
      
      
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Documentos_Referencia
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pm1(p_Trama_Pm(l_Item).Subtrama_Pm1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Descuentos_Aplicados
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pm2(p_Trama_Pm(l_Item).Subtrama_Pm2
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Puntos_Generados
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pm3(p_Trama_Pm(l_Item).Subtrama_Pm3
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Distribucion_Convenio
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pm4(p_Trama_Pm(l_Item).Subtrama_Pm4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Impuestos_Aplicados
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pm5(p_Trama_Pm(l_Item).Subtrama_Pm5));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
                                   
      --INI JAGC 20240909 NECESIDADES 'NEC'  
      IF Nvl(p_Version
            ,'POS') IN (
                  'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                 ,'NEU','ONS' ,'OBE' --JAGC 20261022
                 ) THEN
        
           l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm(l_Item).Descuentos_Aplicados_Perdidos
                                                                ,0)
                                                            ,1));
           l_Registro  := Utl_Raw.Concat(l_Registro
                                       ,Arma_Trama_Pm9(p_Trama_Pm(l_Item).Subtrama_Pm9
                                                      ,p_Version));
      
      END IF;
      --FIN JAGC 20240909 NECESIDADES 'NEC'
                                   
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PM';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pm1(p_Trama_Pm1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pm1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pm1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm1(l_Item).Secuencia_b
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm1(l_Item).Total_Item_Por_Documento
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm1(l_Item).Decimal_Total_Item
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pm2(p_Trama_Pm2 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pm2
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pm2.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Secuencia_b
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Tipo_Descuento
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Campana_o_Convenio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Codigo_Cupon
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Monto_Documento
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Decimal_Monto_Docto
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Puntos_Canjeados
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Convertibilidad_Pesos_Puntos
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Tipo_Aplicacion_Descuento
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Id_Descuento_Complementario
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
      --INI JAGC 20240909 NECESIDADES 'NEC'  
      IF Nvl(p_Version
            ,'POS') IN (
                  'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                 ,'NEU','ONS' ,'OBE' --JAGC 20261022
                 ) THEN
        
            l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Detalle_Descuento_Producto
                                                                       ,' ')
                                                                   ,1000 --JAGC PROVISIONAL NEC 20250224
                                                                   --,40 --JAGC PROVISIONAL NEC 20250224
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      
      ELSE                                                                  
                                                              
            l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Detalle_Descuento_Producto
                                                                       ,' ')
                                                                   ,250
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      
      END IF;
      --FIN JAGC 20240909 NECESIDADES 'NEC'                                                         
                                                              
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Descuento_Financiado
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Secuencia_Financiamiento
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm2(l_Item).Unidades_Beneficio
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Descuento_Referencial
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('SGN'
                       ,'OTN'
                       ,'CCR'
                       ,'ISP'
                       ,'COR'
                       ,'SQF'
                       ,'CCV'
                       ,'BOX'
                       ,'GLO'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        --erika 29112018
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Signo
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      --//--------------------------------------------------------------------------\\
      --// CBR 27/12/2017 15:03  BOX AHORRO                                         \\
      --//-----------------------------------------------------------------Inicio---\\
      IF Nvl(p_Version
            ,'POS') IN ('BOX'
                       ,'GLO'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Pertenece_Club
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));                                                            
      END IF;
      --//-----------------------------------------------------------------Termino--\\
       -- IDHC
        if Nvl(p_Version ,'POS') in ('MSP'
                                    ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                                    ,'NEU','ONS' ,'OBE' --JAGC 20261022          
                                    ,'CON','OMS') then
            l_Registro := Utl_Raw.Concat(l_Registro
                                        ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm2(l_Item).Promotion_web
                                                                             ,' ')
                                                                         ,6
                                                                         ,' ')
                                                                    ,'WE8MSWIN1252')));   
        end if;                                                             
      
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;
  
