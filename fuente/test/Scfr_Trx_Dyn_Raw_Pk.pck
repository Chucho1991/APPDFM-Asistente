      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Nombre_Vendedor
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Nombre_Vendedor
