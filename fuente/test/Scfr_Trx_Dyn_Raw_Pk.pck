                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Nombre_Pro
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Descripcion_Pro
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Descripcion_Pro
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Fecha_Creacion
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Fecha_Creacion
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Fecha_Actualizacion
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Fecha_Actualizacion
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Habilitado
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Habilitado
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Eliminado
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Eliminado
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Sistema
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Sistema
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      --------------
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Id_Currency
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp3(l_Item).Id_Currency
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Nombre_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Nombre_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Nombre_Corto_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Nombre_Corto_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Descripcion_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Descripcion_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Fecha_Creacion_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Fecha_Creacion_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Eliminado_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Eliminado_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp3(l_Item).Estado_Currency
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp3(l_Item).Estado_Currency
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;
  --//-----------------------------------------------------------------Termino--\\

  FUNCTION Arma_Trama_Dc(p_Trama_Dc IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Dc) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Rut_Facturacion
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Rut_Facturacion
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Dv_Rut_Facturacion
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Dv_Rut_Facturacion
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Party_Id
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Party_Id
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Razon_Social
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Razon_Social
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Nombre_Fantasia
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Nombre_Fantasia
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Giro
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Giro
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Direccion_Facturacion
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Direccion_Facturacion
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Comuna_Facturacion
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Comuna_Facturacion
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Ciudad_Facturacion
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Ciudad_Facturacion
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Direccion_Envio_Correo
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Direccion_Envio_Correo
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Comuna_Envio_Correspondencia
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Comuna_Envio_Correspondencia
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Ciudad_Envio_Correspondencia
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Ciudad_Envio_Correspondencia
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Telefono
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Telefono
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Fax
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dc.Fax
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Dc.Email
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dc.Email
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'DC';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ms(p_Trama_Ms IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ms) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ms.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Largo     := Lengthb(Nvl(p_Trama_Ms(l_Item).Mensaje
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ms(l_Item).Mensaje
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Ms(l_Item).Dirigido
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ms(l_Item).Dirigido
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Ms(l_Item).Medio_Comunicacion
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ms(l_Item).Medio_Comunicacion
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'MS';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pu(p_Trama_Pu IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pu
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Largo     NUMBER;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pu.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pu(l_Item).Signo
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pu(l_Item).Puntos
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pu(l_Item).Donacion_Vigente
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      --//--------------------------------------------------------------------------\\
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pu(l_Item).Identi_Beneficiario
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pu(l_Item).Rut_Beneficiario
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pu(l_Item).Dv_Rut_Beneficiario
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      --//--------------------------------------------------------------------------\\
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pu(l_Item).Nombre
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pu(l_Item).Fecha_Inicio
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pu(l_Item).Fecha_Termino
                                                               ,0)
                                                           ,4));
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('PRM'
                       ,'CCR'
                       ,'ISP'
                       ,'COR'
                       ,'SQF'
                       ,'CCV'
                       ,'SPA'
                       ,'BIO'
                       ,'GLO'
                       ,'BOX'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pu(l_Item).Vigencia
                                                                 ,0)
                                                             ,2));
      END IF;
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PU';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

