  FUNCTION Arma_Trama_Ec1(p_Trama_Ec1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ec1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
