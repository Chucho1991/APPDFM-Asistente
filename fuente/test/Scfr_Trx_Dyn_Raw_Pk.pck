      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vs1(l_Item).Precio_Final
                                                                ,0)
                                                            ,4));

    --INI JAGC 20250414 ORIGEN FGI
      l_Registro  := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vs1(l_Item).Numero_Item
                                       ,0)
                                     ,8));
      
      l_Registro  := Utl_Raw.Concat(l_Registro
