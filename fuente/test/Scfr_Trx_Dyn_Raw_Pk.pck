      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Bonificacion
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Descuento
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Afecto_Sgdo_Credito
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Porcentaje_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Monto_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Deducible_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Tope_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Numero_Plan
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Codigo_Ges
