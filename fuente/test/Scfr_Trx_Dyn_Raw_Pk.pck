        l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_pq(l_item).porcentaje_bonif_informado   ,0 ), 8 ) );
        l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_pq(l_item).monto_bonif_informado        ,0 ), 8 ) );
        l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_pq(l_item).deducible_aplicado_en_pesos  ,0 ), 8 ) );
        l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_pq(l_item).tope_aplicado_en_pesos       ,0 ), 8 ) );
      end if;
      l_registro  := utl_raw.concat( scfr_trx_util_pk.num2bin( utl_raw.length(l_registro), 2 ), l_registro );
      l_respuesta := utl_raw.concat( l_respuesta, l_registro );
    end loop;
    l_trama_htx.tipo_informacion   := 'PQ';
    l_trama_htx.modo_largo_campos  := 'F';
    l_trama_htx.largo_buffer_datos := dbms_lob.getlength( l_respuesta );
    l_trama_htx.cantidad_registros := l_tot_reg;
    l_respuesta := utl_raw.concat( arma_trama_htx( l_trama_htx ), l_respuesta );
    return l_respuesta;
  end;
  */
