/
CREATE OR REPLACE PACKAGE BODY TRX3.Scfr_Trx_Dyn_Raw_Pk AS

  FUNCTION Version_Pkg RETURN VARCHAR2 AS
  BEGIN
    RETURN Vversion;
  END;

  FUNCTION Arma_Trama_Do(p_Trama_Do IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Do
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Respuesta BLOB;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Do.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      -- IF Nvl(p_Version,'POS') IN ('OTN','SAP') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Numero_Orden_Trabajo
                                                                       ,' ')
                                                                   ,14
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      -- ELSE
      --   l_Registro := Utl_Raw.Concat(l_Registro,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Numero_Orden_Trabajo,' '),13,' '),'WE8MSWIN1252')));
      -- END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Codigo_Respuesta
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Glosa_Respuesta
                                                                       ,' ')
                                                                   ,80
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Secuencia_Receta
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Fecha_Hora_Estado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Estado
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('SAP') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Numero_Rp
                                                                 ,0)
                                                             ,6));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Numero_Rp
                                                                 ,0)
                                                             ,3));
      END IF;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Fecha_Vencimiento
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Monto_Abono
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Valor_Total
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Costo_Total
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Retiro
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Local
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Do(l_Item).Tipo_Recepcion
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Do(l_Item).Total_Envases
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'DO';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  /*** gncc01 ***/
  FUNCTION Arma_Trama_Dp(p_Trama_Dp IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Dp
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Apellido_Paterno
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Apellido_Paterno
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Apellido_Materno
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Apellido_Materno
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Nombres
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Nombres
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    IF Nvl(p_Version
          ,'POS') IN ('ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'VCO'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'DON'
                     ,'MOP') THEN
      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Segundo_Nombre
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Segundo_Nombre
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
  
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Sexo
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Sexo
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Fecha_Nacimiento
                             ,0));
