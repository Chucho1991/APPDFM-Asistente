  FUNCTION Arma_Trama_Cz(p_Trama_Cz IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Cz) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cz.Uso_Frecuente
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cz.Rut_Medico
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cz.Dv_Rut_Medico
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cz.Folio
                                                                                 ,0)
