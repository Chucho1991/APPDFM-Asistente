  --FIN JAGC 20240909 NECESIDADES 'NEC'
    
    --//-----------------------------------------------------------------Termino--\\
  
    --    if nvl( p_version, 'POS' ) in ( 'ATR', 'EMP' ,'MTL','MET') then
