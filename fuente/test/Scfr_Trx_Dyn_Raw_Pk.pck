  FUNCTION Arma_Trama_Vs1(p_Trama_Vs1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Vs1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
