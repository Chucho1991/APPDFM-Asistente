  --//--------------------------------------------------------------------------\\
  --// CBR 23/11/2020 13:05                                                     \\
  --// Desarrollos para resolutor Ecuador con nuevo origen transaccion 'DEC'    \\
  --// Arma Trama Consulta Vademecum                                            \\
  --//-----------------------------------------------------------------Inicio---\\
  FUNCTION Arma_Trama_Ve(p_Trama_Ve IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ve
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.Tipo_Consulta
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.Tipo_Consulta
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.String_01
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.String_01
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.String_02
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.String_02
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.String_03
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.String_03
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.String_04
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.String_04
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Largo    := Lengthb(Nvl(p_Trama_Ve.String_05
                             ,' '));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ve.String_05
                                                                     ,' ')
                                                                 ,l_Largo
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
