  FUNCTION Arma_Trama_Ac(p_Trama_Ac IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ac) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Convenio
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Plan
                                                             ,0)
                                                         ,3));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Digito_Verificador_Rut
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Secuencia_b
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Medico
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Medico
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Codigo_Receta
                                                                     ,' ')
                                                                 ,15
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Institucion
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Institucion
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Fecha_Receta
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Comprador
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Comprador
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Cantidad_Periodos
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Perfil
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Secuencia_Receta
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Receta_Nueva
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Ges_Uso_Receta
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Uso_Excedente
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- JRG CIA 04/06/219
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Plan_Con_Guia
                                                                     ,'NO')
                                                                 ,2
                                                                 ,'NO')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                         ,2)
                                ,l_Registro);
  
    l_Trama_Htx.Tipo_Informacion   := 'AC';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ac(p_Trama_Ac IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ac
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Convenio
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Plan
                                                             ,0)
                                                         ,3));
    IF Nvl(p_Version
          ,'POS') NOT IN ('ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Digito_Verificador_Rut
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Secuencia_b
                                                             ,0)
                                                         ,1));
    IF Nvl(p_Version
          ,'POS') NOT IN ('ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Medico
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Medico
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Codigo_Receta
                                                                     ,' ')
                                                                 ,15
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Institucion
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Institucion
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Fecha_Receta
                                                             ,0)
                                                         ,4));
    IF Nvl(p_Version
          ,'POS') NOT IN ('ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Comprador
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Dv_Rut_Comprador
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Cantidad_Periodos
                                                             ,0)
                                                         ,1));
    IF Nvl(p_Version
          ,'POS') NOT IN ('ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Rut_Perfil
                                                               ,0)
                                                           ,4));
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Secuencia_Receta
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Receta_Nueva
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Ges_Uso_Receta
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Uso_Excedente
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- JRG CIA 04/06/219
    IF Nvl(p_Version
          ,'POS') IN ('CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador Para origen tx SAL
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Plan_Con_Guia
                                                                       ,'  ')
                                                                   ,3
                                                                   ,'  ')
                                                              ,'WE8MSWIN1252')));
    END IF; -- IF Nvl(p_Version,'POS') IN ('CIA') THEN
  
    IF Nvl(p_Version
          ,'POS') IN ('ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador Para origen tx SAL
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Codigo_Medico
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Identificador_Titular
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Identificacion_Comprador
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Identificacion_Perfil
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF; -- IF Nvl(p_Version,'POS') IN ('CIA') THEN
    IF Nvl(p_Version
          ,'POS') IN ('SAM'
                     ,'SAL'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ) THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac.Party_Id_Cliente_c
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('SAL'
            ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
            ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
            ,'NEU','ONS' ,'OBE' --JAGC 20261022
            ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON 
      ) THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ac.Lista_Diagnosticos
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Ac1(p_Trama_Ac.Subtrama_Ac1));
    END IF;
  
    l_Registro := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                         ,2)
                                ,l_Registro);
  
    l_Trama_Htx.Tipo_Informacion   := 'AC';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ac1(p_Trama_Ac1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ac1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ac1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ac1(l_Item).Diagnostico
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

