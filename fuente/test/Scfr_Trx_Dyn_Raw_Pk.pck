    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Codigo_Pais
                             ,0));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp.Codigo_Pais
                                                             ,0)
                                                         ,l_Largo));
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Codigo_Region
                             ,0));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp.Codigo_Region
                                                             ,0)
                                                         ,l_Largo));
    --    end if;
  
    IF Nvl(p_Version
          ,'POS') IN ('ISP'
                     ,'SQF'
                     ,'CCV'
                     ,'SPA'
                     ,'BIO'
                     ,'GLO'
                     ,'BOX'
                     ,'FEL'
                     ,'FAT'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Institucion_Salud
