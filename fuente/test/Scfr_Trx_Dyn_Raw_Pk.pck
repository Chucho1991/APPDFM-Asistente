  FUNCTION Arma_Trama_Vn1(p_Trama_Vn1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Vn1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Vn1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Cantidad
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Precio_Final
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Costo
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Codigo_Personal
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Rut_Vendedor
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vn1(l_Item).Dv_Rut_Vendedor
                                                                        ,' ')
                                                                    ,1
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vn1(l_Item).Precio_Lista
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vn1(l_Item).Codigo_Reclamo
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

