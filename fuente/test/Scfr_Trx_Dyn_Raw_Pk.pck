                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Codigo_Local_Socofar
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Numero_Reclamo
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Fecha_Reclamo
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Dfi_Numero_Asignacion
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Matricula_Bulto
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Monto
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Rut_Proveedor
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Sello_Seguro_Uno
                                                                                 ,0)
