  -- cnvc52
  FUNCTION Arma_Trama_Lf(p_Trama_Lf IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Lf
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Lf.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Lf.Codigo_Autorizacion_Externo
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    IF Nvl(p_Version
          ,'POS') IN ('GES'
                     ,'BNM'
                     ,'EMP') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Lf.Tipo_Reversa
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Lf.Monto_Reversa
                                                               ,0)
                                                           ,4));
    END IF;
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'LF';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  /**********************************************************************************/
  FUNCTION Arma_Trama_Ab(p_Trama_Ab IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ab) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ab.Tipo_Movimiento_Padre
                                                                                         ,' ')
                                                                                     ,6
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ab.Tipo_Movimiento_Hijo
                                                                                         ,' ')
                                                                                     ,6
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ab.Folio
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ab.Monto
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ab.Precio_Final
                                                                                 ,0)
                                                                             ,8));
    --INI JAGC 20250414 ORIGEN FGI
      l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ab.Folio_Ajuste
                                                                                 ,0)
                                                                             ,8));
    --FIN JAGC 20250414 ORIGEN FGI
                                                                             
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ab.Cantidad_Productos
                                                                                 ,0)
                                                                             ,2));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Ab1(p_Trama_Ab.Subtrama_Ab1));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'AB';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ab1(p_Trama_Ab1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ab1) RETURN BLOB IS
    l_Registro  BLOB;
