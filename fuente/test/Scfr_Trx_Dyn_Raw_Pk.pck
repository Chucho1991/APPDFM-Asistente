                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
