    --    if nvl( p_version, 'POS' ) in ( 'LNA', 'GES' ,'CRD' , 'DTO' , 'CAM' , 'CCR','SQF' ,'REC', 'SCB', 'ATR', 'EMP','MTL','MET') then
    l_Largo    := Lengthb(Nvl(p_Trama_Dp.Fecha_Hora_Ultima_Venta
