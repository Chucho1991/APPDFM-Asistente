    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Htx.Tipo_Informacion
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Htx.Modo_Largo_Campos
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Htx.Largo_Buffer_Datos
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Htx.Cantidad_Registros
                                                             ,0)
                                                         ,2));
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Lo(p_Trama_Lo IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Lo) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Lo.Fecha_Inicio
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Lo.Hora_Inicio
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Lo.Version_Primaria_Adlc
                                                                                         ,' ')
                                                                                     ,15
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Lo.Version_Secundaria_Adlc
                                                                                         ,' ')
                                                                                     ,15
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'LO';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Md(p_Trama_Md IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Md) RETURN BLOB IS
