                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Nv1(l_Item).Costo
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Nv1(l_Item).Codigo_Personal
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Nv1(l_Item).Rut_Vendedor
