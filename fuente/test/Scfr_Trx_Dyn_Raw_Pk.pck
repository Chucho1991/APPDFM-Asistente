  FUNCTION Arma_Trama_Htx(p_Trama_Htx IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
