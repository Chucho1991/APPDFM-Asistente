                                                                                 ,0)
    
                                                                             ,8));
    
     --INI JAGC 20250414 ORIGEN FGI
     l_Registro                    := Utl_Raw.Concat(l_Registro
                                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.FOLIO_INGRESO
                                                                               ,0)
                                                                           ,8)); 
    --FIN JAGC 20250414 ORIGEN FGI   
    
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dl.Cantidad_Productos
