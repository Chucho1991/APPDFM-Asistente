                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Dosis
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Veces
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Dias
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Cantidad_Original
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Codigo_De_Respuesta
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Mensaje_Producto
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Dias_Tratamiento
                                                               ,0)
                                                           ,2));
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Precio
                                                               ,0)
                                                           ,8));      
                                                           
      --nuevo
      IF Nvl(p_Version
            ,'POS') IN ('MSP'
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON'
            ) THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Decimal_Precio
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));      
      
      END IF;
      --fin nuevo
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Tipo_Bonificacion
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Bonificacion
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Descuento
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Afecto_Sgdo_Credito
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Porcentaje_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Monto_Bonif_Informado
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Deducible_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Tope_Aplicado_En_Pesos
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Numero_Plan
                                                               ,0)
                                                           ,3));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Po(l_Item).Codigo_Ges
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Folio_Bono
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Po(l_Item).Cantidad_Sustitutos
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Po1(p_Trama_Po(l_Item).Subtrama_Po1));
    
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PO';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

-- ============================================================

  FUNCTION Arma_Trama_Pe(p_Trama_Pe IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pe
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pe.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Id_Periodo
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Fecha_Inicio
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Fecha_Termino
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Monto_Copago
                                                               ,0)
                                                           ,8));
      IF Nvl(p_Version
            ,'POS') IN ('BNM'
                       ,'EBM'
                       ,'PRM'
                       ,'SGN'
                       ,'OTN'
                       ,'DPE'
                       ,'CCR'
                       ,'SQF'
                       ,'CCV'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM'
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Folio_Bono
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pe(l_Item).Folio_Copago
                                                                 ,0)
                                                             ,8));
      END IF;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pe(l_Item).Periodo_Desmarcable
                                                                        ,' ')
                                                                    ,2
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PE';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pq(p_Trama_Pq IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pq
