                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vs1(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vs1(l_Item).Cantidad
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vs1(l_Item).Motivo
                                                                        ,' ')
                                                                    ,6
