  FUNCTION Arma_Trama_Te(p_Trama_Te IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Te) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Timespan
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Te.Timespan
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Respuesta
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Respuesta
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_No_Enrutada
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_No_Enrutada
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_No_Existe
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_No_Existe
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Timeout
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Timeout
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Erronea
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Erronea
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Expirada
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Expirada
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Online
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Online
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Confirmada
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Confirmada
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Te.Tx_Nack
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Te.Tx_Nack
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'TE';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Tm(p_Trama_Tm IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Tm
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Tm.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm(l_Item).Convenio
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm(l_Item).Plan
                                                                ,0)
                                                            ,3));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm(l_Item).Lista_Productos
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Tm1(p_Trama_Tm(l_Item).Subtrama_Tm1
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'TM';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Tm1(p_Trama_Tm1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Tm1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Tm1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Codigo_Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Dias_Autorizados
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Fecha_Inicio
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Fecha_Termino
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Local
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tm1(l_Item).Fecha_Compra
                                                                ,0)
                                                            ,4));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Tp(p_Trama_Tp IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Tp) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tp.Correlativo_Tx
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tp.Puntos
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tp.Destino
                                                                                         ,' ')
                                                                                     ,3
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'TP';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Va(p_Trama_Va IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Va
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Convenio
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Plan
                                                             ,0)
                                                         ,3));
  
    IF Nvl(p_Version
          ,'POS') NOT IN ('ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Rut_Titular
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Dv_Titular
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Secuencia_b
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Precio_Lista
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Bonificacion
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Bonificacion_2
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Copago
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Cantidad_Cuotas
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Monto_Copago_Ges
                                                             ,0)
                                                         ,8));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Numero_Boleta
                                                                     ,' ')
                                                                 ,15
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    IF Nvl(p_Version
          ,'POS') IN ('CCR'
                     ,'COR'
                     ,'SQF'
                     ,'CCV'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Requiere_Id_Receta
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
  
    -- JRG CIA 04/06/219
    IF Nvl(p_Version
          ,'POS') IN ('CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Plan_Con_Guia
                                                                       ,'NO')
                                                                   ,2
                                                                   ,'NO')
                                                              ,'WE8MSWIN1252')));
    END IF; -- IF Nvl(p_Version,'POS') IN ('CIA') THEN
  
    IF Nvl(p_Version
          ,'POS') IN ('ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Identificador_Titular
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Identificacion_Comprador
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      -----------------------------------------------------------------
      -- LMP 2023 GPF Ecuador para nuevo origen SAL
      ------------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('SAL'
            ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
            ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
            ,'NEU','ONS' ,'OBE' --JAGC 20261022
            ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
      ) THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Serie_Factura
                                                                         ,' ')
                                                                     ,50
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Clave_Acceso
                                                                         ,' ')
                                                                     ,50
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.Id_Prestador
                                                                         ,' ')
                                                                     ,50
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va.De_Mail
                                                                         ,' ')
                                                                     ,50
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Va.Lista_Diagnosticos
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Va1(p_Trama_Va.Subtrama_Va1));
    END IF;
  
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'VA';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Va1(p_Trama_Va1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Va1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Va1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Va1(l_Item).Diagnostico
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

