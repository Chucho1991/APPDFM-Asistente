  FUNCTION Arma_Trama_Fm(p_Trama_Fm IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Fm) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Fm.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fm(l_Item).Codigo_Movimiento
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fm(l_Item).Fecha_Transaccion
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fm(l_Item).Movimiento_Padre
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fm(l_Item).Codigo_Item
                                                                ,0)
                                                            ,3));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'FM';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Fs(p_Trama_Fs IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Fs) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Fs.Producto
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fs.Producto
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'FS';
    l_Trama_Htx.Modo_Largo_Campos  := '';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Gf(p_Trama_Gf IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Gf
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Tipo_Movimiento_Hijo
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    IF Nvl(p_Version
          ,'POS') IN ('DEC'
                     ,'ABF'
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'PDL'
                     ,'BNT'
                     ,'NLG' -- JAGC 20240319
                     ,'NUF') THEN                     
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Folio
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    ELSE
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Folio
                                                               ,0)
                                                           ,8));
    END IF;
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Numero_Pedido
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Fecha
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Codigo_Local_Socofar
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Numero_Reclamo
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Fecha_Reclamo
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Accion_Sobre_Existencia
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Monto
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Decimal_Monto
                                                             ,0)
                                                         ,4));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Ident_Proveedor
                                                                     ,' ')
                                                                 ,30
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    --    l_Registro                     := Utl_Raw.Concat(l_Registro
    --                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Rut_Proveedor
    --                                                                                 ,0)
    --                                                                             ,4));

    IF Nvl(p_Version --JRC 30/08/2023 Unificando EXCU17 desde Yza a Ecuador
          ,'POS') IN ('NUF'
                     ,'BNT'
                     ,'NLG' -- JAGC 20250319
                     ) THEN

      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf.Numero_Factura
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    
    --INI JAGC 20250414 ORIGEN FGI
    IF Nvl(p_Version
        ,'POS') IN ('FGI') THEN
        
       l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.FOLIO_INGRESO
                                                             ,0)
                                                         ,8)); 
        
    END IF;
    --FIN JAGC 20250414 ORIGEN FGI  
        
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf.Cantidad_Productos
                                                                                 ,0)
                                                                             ,2));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Gf1(p_Trama_Gf.Subtrama_Gf1));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'GF';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Gf1(p_Trama_Gf1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Gf1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Gf1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
    
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'PDL') THEN                       
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Guia_Electronica
                                                                         ,' ')
                                                                     ,20
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Guia_Electronica
                                                                 ,0)
                                                             ,8));
      END IF;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Producto
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Decimal_Cantidad
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Tipo_Falta_Producto
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Motivo
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Guia_Facturable
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Costo
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Decimal_Costo
                                                               ,0)
                                                           ,4));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Codigo_Personal
                                                               ,0)
                                                           ,2));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Ident_Vendedor
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      --      l_Registro  := Utl_Raw.Concat(l_Registro
      --                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Rut_Vendedor
      --                                                                ,0)
      --                                                            ,4));
      --      l_Registro  := Utl_Raw.Concat(l_Registro
      --                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gf1(l_Item).Dv_Rut_Vendedor
      --                                                                        ,' ')
      --                                                                    ,1
      --                                                                    ,' ')
      --                                                               ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Precio_Lista
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gf1(l_Item).Decimal_Precio_Lista
                                                               ,0)
                                                           ,4));
    
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Gs(p_Trama_Gs IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Gs) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs.Correlativo_Tx
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs.Cantidad_Productos
                                                                                 ,0)
                                                                             ,2));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Gs1(p_Trama_Gs.Subtrama_Gs1));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'GS';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Gs1(p_Trama_Gs1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Gs1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Gs1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs1(l_Item).Folio
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs1(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs1(l_Item).Uso_Frecuente
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gs1(l_Item).Cantidad
                                                                ,0)
                                                            ,2));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Hbo(p_Trama_Hbo IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Hbo) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Hbo.Forma_Identificacion
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Hbo.String_Identificacion
                                                                     ,' ')
                                                                 ,150
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hbo.Party_Id
                                                             ,0)
                                                         ,7));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Hbo.Codigo_Respuesta
                                                             ,0)
                                                         ,2));
