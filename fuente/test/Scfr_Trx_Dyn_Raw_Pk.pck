  FUNCTION Arma_Trama_Mc(p_Trama_Mc IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Mc
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Correlativo
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Fecha
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Hora
                                                             ,0)
                                                         ,4));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Identi_Titular
                                                                     ,' ')
                                                                 ,30
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    --    l_Registro := Utl_Raw.Concat(l_Registro
    --                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Rut_Titular
    --                                                             ,0)
    --                                                         ,4));
    --    l_Registro := Utl_Raw.Concat(l_Registro
    --                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Dv_Titular
    --                                                                     ,' ')
    --                                                                 ,1
    --                                                                 ,' ')
    --                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Fecha_Generacion
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Registro_Electronico
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Correlativo_Tx
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Cant_Remesas_Depo
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Decimal_Cant_Remesas
                                                                     ,' ')
                                                                 ,4
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Monto_No_Depositado
                                                             ,0)
                                                         ,8));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Decimal_Mto_No_Depo
                                                                     ,' ')
                                                                 ,4
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Cant_Remesas_No_Depo
                                                             ,0)
                                                         ,4));
  
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Mc.Decimal_Remesas_No_Depo
                                                                                         ,' ')
                                                                                     ,4
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Mc.Cantidad_Documentos
                                                                                 ,0)
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Mc1(p_Trama_Mc.Subtrama_Mc1
                                                                   ,p_Version));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
