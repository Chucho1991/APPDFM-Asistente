  FUNCTION Arma_Trama_Cl(p_Trama_Cl IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Cl) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cl.Autorizacion
                                                                                         ,' ')
                                                                                     ,2
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cl.Valida_Lista
                                                                                         ,' ')
                                                                                     ,2
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'CL';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Pl(p_Trama_Pl IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pl
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pl.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Codigo_Producto
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Dosis
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Veces
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Dias
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pl(l_Item).Enviar_Sustituto
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Precio_Lista
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Precio
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Codigo_Barra
                                                               ,0)
                                                           ,6));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Descuento_Financiado
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('CCR'
                       ,'SQF'
                       ,'CCV'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Numero_Retiro
                                                                 ,0)
                                                             ,2));
      END IF;
    
      IF Nvl(p_Version
            ,'POS') IN ('SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
            ) THEN
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pl(l_Item).Decimal_Precio_Lista
                                                                         ,' ')
                                                                     ,4
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pl(l_Item).Decimal_Precio_Final
                                                                         ,' ')
                                                                     ,4
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pl(l_Item).Monto_Iva
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pl(l_Item).Decimal_Iva
                                                                         ,' ')
                                                                     ,4
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
    
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PL';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;
