                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pt.Local
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pt.Rut_Vendedor
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pt.Dv_Rut_Vendedor
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pt.Correlativo_Tx
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'PT';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  /*FUNCTION arma_trama_pv(p_trama_pv IN scfr_trx_dyn_types_pk.tab_trama_pv) RETURN BLOB IS
    l_trama_htx scfr_trx_dyn_types_pk.rec_trama_htx;
    l_registro BLOB;
    l_largo NUMBER;
    l_respuesta BLOB;
    l_item NUMBER;
    l_tot_reg NUMBER;
  BEGIN
    l_respuesta := NULL;
    l_tot_reg := p_trama_pv.COUNT;
    FOR l_item IN 1 .. l_tot_reg LOOP
      l_registro := NULL;
      l_registro := utl_raw.concat(l_registro, scfr_trx_util_pk.num2bin(nvl(p_trama_pv(l_item).id_periodo, 0), 1));
      l_registro := utl_raw.concat(l_registro, scfr_trx_util_pk.num2bin(nvl(p_trama_pv(l_item).fecha_inicio, 0), 4));
      l_registro := utl_raw.concat(l_registro, scfr_trx_util_pk.num2bin(nvl(p_trama_pv(l_item).fecha_termino, 0), 4));
      l_registro := utl_raw.concat(l_registro, scfr_trx_util_pk.num2bin(nvl(p_trama_pv(l_item).monto_copago, 0), 8));
      l_registro := utl_raw.concat(l_registro, scfr_trx_util_pk.num2bin(nvl(p_trama_pv(l_item).folio_copago, 0), 8));
      l_registro := utl_raw.concat(l_registro,
                                   utl_raw.cast_to_raw(convert(rpad(nvl(p_trama_pv(l_item).periodo_pagado, ' '), 1, ' '), 'WE8MSWIN1252')));
      l_registro := utl_raw.concat(scfr_trx_util_pk.num2bin(utl_raw.length(l_registro), 2), l_registro);
      l_respuesta := utl_raw.concat(l_respuesta, l_registro);
    END LOOP;
    l_trama_htx.tipo_informacion := 'PV';
    l_trama_htx.modo_largo_campos := 'F';
    l_trama_htx.largo_buffer_datos := dbms_lob.getlength(l_respuesta);
    l_trama_htx.cantidad_registros := l_tot_reg;
    l_respuesta := utl_raw.concat(arma_trama_htx(l_trama_htx), l_respuesta);
    RETURN l_respuesta;
  END;*/
  FUNCTION Arma_Trama_Ra(p_Trama_Ra IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ra) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ra.Tarjeta_Invitado
                                                                                         ,' ')
                                                                                     ,20
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'RA';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Rb(p_Trama_Rb IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rb
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rb.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Numero_Manifiesto
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Fecha_Manifiesto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Numero_Despacho
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Fecha_Despacho
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb(l_Item).Patente_Transporte
                                                                        ,' ')
                                                                    ,7
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Fecha_Hora_Recepcion
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Fecha_Hora_Ingreso_Vendible
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb(l_Item).Tipo_Recepcion_Manifiesto
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb(l_Item).Cantidad_Bultos
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Rb1(p_Trama_Rb(l_Item).Subtrama_Rb1
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'RB';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rb1(p_Trama_Rb1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rb1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rb1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Numero_Pedido
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Codigo_Bulto
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Matricula_Bulto
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb1(l_Item).Tipo_Bulto
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb1(l_Item).Recepcionado
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('SCF') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Recepcion
                                                                 ,0)
                                                             ,8));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Recepcion
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb1(l_Item).Devuelto
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('SCF') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Devolucion
                                                                 ,0)
                                                             ,8));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Devolucion
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Guia_Devolucion
                                                               ,0)
                                                           ,8));
      IF Nvl(p_Version
            ,'POS') IN ('SCF') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Ingreso
                                                                 ,0)
                                                             ,8));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Ingreso
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Revision_Ini
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Fecha_Revision_Fin
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rb1(l_Item).Tipo_Recepcion_Bulto
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Numero_Pedido_Proveedor
                                                               ,0)
                                                           ,8));
      IF Nvl(p_Version
            ,'POS') IN ('SCF') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Folio_Guia_Reclamo
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rb1(l_Item).Numero_Reclamo
                                                                 ,0)
                                                             ,8));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rcv(p_Trama_Rcv IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rcv) RETURN BLOB IS
