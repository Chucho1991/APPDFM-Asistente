  FUNCTION Arma_Trama_Pz(p_Trama_Pz IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Pz) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Producto
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pz.Producto
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Familia_Comercial
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,3));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pz.Familia_Comercial
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Tipo_Descuento
                                                 ,' '));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,3));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pz.Tipo_Descuento
                                                                                         ,' ')
                                                                                     ,l_Largo
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Descuento
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pz.Descuento
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Campana
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,3));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pz.Campana
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pz.Uso_Frecuente
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pz.Uso_Frecuente
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'PZ';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

