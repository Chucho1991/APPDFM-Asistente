  FUNCTION Arma_Trama_Cg(p_Trama_Cg IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Cg) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Cg.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Codigo_Cupon
                                                                        ,' ')
                                                                    ,15
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Estado
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cg(l_Item).Campana
                                                                ,0)
                                                            ,3));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cg(l_Item).Fecha
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cg(l_Item).Rut
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Digito_Verificador_Rut
                                                                        ,' ')
                                                                    ,1
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Apellido_Paterno
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Apellido_Materno
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cg(l_Item).Nombre
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cg(l_Item).Local
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cg(l_Item).Folio
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'CG';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Ck(p_Trama_Ck IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ck) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ck.Cantidad_Locales
                                                                                 ,0)
                                                                             ,2));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ck.Cantidad_Productos
                                                                                 ,0)
                                                                             ,2));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Ck1(p_Trama_Ck.Subtrama_Ck1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Ck2(p_Trama_Ck.Subtrama_Ck2));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'CK';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

