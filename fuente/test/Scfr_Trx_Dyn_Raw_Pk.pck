      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Estado
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
       
      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Fecha_Inscripcion
                             ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
