                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Canal
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
