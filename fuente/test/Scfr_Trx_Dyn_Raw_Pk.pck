                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Br.Dv_Paciente
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Br.Convenio
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Br.Plan
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'BR';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  -- ============================================================
  -- DESARROLLO CUENTA CORRIENTE RECETA ( FIN )
  -- ============================================================
  -- gncc03
  FUNCTION Arma_Trama_Dr(p_Trama_Dr IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Dr
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Correlativo_Tx
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Fecha
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Hora_Recaudacion
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Secuencia_b
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Numero_Cuenta
                                                                     ,' ')
                                                                 ,19
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- IF Nvl(p_Version,'POS') IN ('OTN','SAP') THEN
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Ot
                                                                     ,' ')
                                                                 ,14
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- ELSE
    --   l_Registro := Utl_Raw.Concat(l_Registro,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Ot,' '),13,' '),'WE8MSWIN1252')));
    -- END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Venta_Relacionada
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Local_Relacionado
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Codigo_Servicio
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Local
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Numero_Pos
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Destino
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Sistema
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Funcion
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Secuencia_c
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Fecha_Transaccion
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Correlativo
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Numero_Trama
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Codigo_Transaccion
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Cuadra_Transaccion
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Documento_Liquidacion_Pago
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Documento_Liquidacion_Empresa
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Codigo_Autorizacion_Externo
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr.Transaccion_Manual
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    IF Nvl(p_Version
          ,'POS') IN ('EMP'
                     ,'MET'
                     ,'TBK'
                     ,'DEV'
                     ,'PRM'
                     ,'FEC'
                     ,'FJC'
                     ,'PRE'
                     ,'MAG'
                     ,'SGN'
                     ,'OTN') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Id_Empresa
                                                               ,0)
                                                           ,4));
    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('FEC'
                     ,'FJC'
                     ,'PRE'
                     ,'MAG'
                     ,'SGN'
                     ,'OTN') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Fecha_Inicio_Tx
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Fecha_Cierre_Tx
                                                               ,0)
                                                           ,8));
    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('PRE'
                     ,'SGN'
                     ,'OTN') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Numero_Tx_Comercio
                                                               ,0)
                                                           ,8));
    END IF;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr.Documentos_Emitidos
                                                                                 ,0)
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Dr1(p_Trama_Dr.Subtrama_Dr1
                                                                   ,p_Version));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'DR';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Dr1(p_Trama_Dr1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dr1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dr1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Secuencia_b
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Tipo_Movimiento_Hijo
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Institucion
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                     
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Numero_Asignacion
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Anulado
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Folio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Tipo_Dicc
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Folio_Dicc
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Total_Iva_Incluido
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Iva
                                                               ,0)
                                                           ,4));
      --//--------------------------------------------------------------------------\\
      --// CBR 30/08/2017 14:34                                                     \\
      --//-----------------------------------------------------------------Inicio---\\
      IF Nvl(p_Version
            ,'POS') IN ('AUC'
                       ,'BOX'
                       ,'GLO'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Signo
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      --//-----------------------------------------------------------------Termino--\\
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Puntos_Asignados
                                                                        ,' ')
                                                                    ,1
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Tipo_Distribucion
                                                                        ,' ')
                                                                    ,3
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Campana
                                                                ,0)
                                                            ,3));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dr1(l_Item).Secuencia_Financiamiento
                                                                ,0)
                                                            ,3));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Documento_Fiscal
                                                                        ,' ')
                                                                    ,2
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
                                                               
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dr1(l_Item).Ruc_Institucion
                                                                       ,' ')
                                                                   ,13
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                                                                                             
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  -- gncc04
  FUNCTION Arma_Trama_Vd(p_Trama_Vd IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Vd
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Correlativo_Tx
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Fecha
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Hora_Venta
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Secuencia_b
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Numero_Cuenta
                                                                     ,' ')
                                                                 ,19
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Local_Relacionado
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Codigo_Servicio
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Local
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Numero_Pos
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Destino
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Sistema
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Funcion
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Secuencia_c
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Fecha_Transaccion
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Correlativo
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Numero_Trama
                                                             ,0)
                                                         ,1));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd.Codigo_Transaccion
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    IF Nvl(p_Version
          ,'POS') IN ('MTL'
                     ,'MET'
                     ,'FEC'
                     ,'FJC'
                     ,'MAG') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Numero_Cuotas
                                                               ,0)
                                                           ,1));
    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('FEC'
                     ,'FJC'
                     ,'MAG') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Fecha_Inicio_Tx
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Fecha_Cierre_Tx
                                                               ,0)
                                                           ,8));
    END IF;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd.Documentos_Emitidos
                                                                                 ,0)
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Vd1(p_Trama_Vd.Subtrama_Vd1));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'VD';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Vd1(p_Trama_Vd1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Vd1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Vd1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd1(l_Item).Secuencia_b
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd1(l_Item).Tipo_Movimiento_Hijo
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vd1(l_Item).Anulado
                                                                        ,' ')
                                                                    ,2
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vd1(l_Item).Total_Iva_Incluido
                                                                ,0)
                                                            ,4));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  /************************************************************************************/
  -- cnvc01
  FUNCTION Arma_Trama_Ar(p_Trama_Ar IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ar
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Permite_Autorizacion_Producto
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Convenio_Cuota
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Afecto_Segundo_Credito
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Saldo
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Saldo_Segundo_Credito
                                                             ,0)
                                                         ,4));
    --    if nvl( p_version, 'POS' ) in ( 'DED' , 'DTO' , 'MSJ' , 'CCR','SQF' , 'SCB', 'PDM', 'ASC','MTL','MET') then
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Tipo_Deducible
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Monto_Deducible
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Valor_Moneda
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Tipo_Moneda
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    --    else
    --      l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_ar.deducible_periodo            ,0 ), 4 ) );
    --      l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_ar.deducible_compra             ,0 ), 4 ) );
    --      l_registro  := utl_raw.concat( l_registro, scfr_trx_util_pk.num2bin( nvl( p_trama_ar.deducible_franquicia         ,0 ), 4 ) );
    --    end if;
    --    if nvl( p_version, 'POS' ) in ( 'DTO' , 'MSJ' , 'CCR','SQF' , 'SCB', 'PDM', 'ASC','MTL','MET') then
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Saldo_Descuento
                                                             ,0)
                                                         ,4));
    --    end if;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Cuadra_Transaccion
                                                                     ,' ')
                                                                 ,2
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Documento_Liquidacion_Pago
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Documento_Liquidacion_Empresa
                                                                     ,' ')
                                                                 ,3
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    --    if nvl( p_version, 'POS' ) in ( 'GES' , 'DED' , 'DTO' , 'MSJ' , 'CCR','SQF' , 'SCB', 'PDM', 'ASC','MTL','MET') then
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Folio_Bono
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Folio_Copago
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Id_Solicitud
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Numero_Tarjeta
                                                                     ,' ')
                                                                 ,15
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    IF Nvl(p_Version
          ,'POS') IN ('ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Codigo_Autorizacion_Ext
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
    END IF;
  
    IF Nvl(p_Version
          ,'POS') IN ('PEX'
                     ,'EC1'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar.Saldo_Decimal
                                                                       ,'0')
                                                                   ,4
                                                                   ,'0')
                                                              ,'WE8MSWIN1252')));
    
    END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Lista_Productos
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Arma_Trama_Ar1(p_Trama_Ar.Subtrama_Ar1
                                               ,p_Version));
    --    if nvl( p_version, 'POS' ) in ( 'SCB', 'PDM', 'ASC','MTL','MET') then
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar.Lista_Cuotas
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Arma_Trama_Ar2(p_Trama_Ar.Subtrama_Ar2));
    --    end if;
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'AR';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ar1(p_Trama_Ar1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ar1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ar1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Codigo_Lista_Productos
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Bonificacion
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Descuento
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Tipo_Lista
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Asociacion_Lista
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Prioridad
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Permite_Levantar_Restriccion
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Maxima_Compra_Producto
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Derecho_Segundo_Credito
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Saldo_Contador
                                                               ,0)
                                                           ,4));
      IF Nvl(p_Version
            ,'POS') IN ('MTL'
                       ,'MET'
                       ,'BNM'
                       ,'EBM'
                       ,'DPE'
                       ,'CCR'
                       ,'SQF'
                       ,'CCV'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAL'    -- LMP 2023 Ecuador GPF
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ar1(l_Item).Descuento_Adicional
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Aplicar_Siempre
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ar1(l_Item).Base_Descuento
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

