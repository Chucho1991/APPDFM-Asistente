                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'RYT'
                       ,'SAM'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'VCO') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm4(l_Item).Decimal_Monto_Distrib
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Pm5(p_Trama_Pm5 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pm5
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pm5.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm5(l_Item).Codigo_Impuesto
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm5(l_Item).Porcentaje_Impuesto
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm5(l_Item).Decimal_Porc_Impuesto
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm5(l_Item).Monto_Impuesto
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm5(l_Item).Decimal_Mto_Impuesto
                                                                ,0)
                                                            ,4));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;
  
  --INI JAGC 20240909 NECESIDADES 'NEC'  
  -------------------------------------------------------------------------
  --SubTrama PM9 2024 JAGC Descuentos Aplicados Perdidoso Necesidades
  -------------------------------------------------------------------------  
  FUNCTION Arma_Trama_Pm9(p_Trama_Pm9 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pm9
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pm9.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Id_descuento_perdido
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Evento_Perdido
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pm9(l_Item).Monto_descuento
                                                                ,0)
                                                            ,4));
                                                            
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Decimal_Monto_Docto
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));                                                      
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Descuento_relacionado
                                                                       ,' ')
                                                                   ,10
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Tipo_descuento_aplicado_perdido
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
      IF Nvl(p_Version
            ,'POS') IN (
                      'NEU','ONS','OBE' --JAGC 20261022
                      ) THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Unidad_Compra
                                                                       ,' ')
                                                                   ,8
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pm9(l_Item).Unidad_Beneficio
                                                                       ,' ')
                                                                   ,8
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      END IF;                                                    
      
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
    
  END;  
  --FIN JAGC 20240909 NECESIDADES 'NEC'

  FUNCTION Arma_Trama_Fp(p_Trama_Fp IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Fp
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Fp.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Codigo_Personal
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Rut
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Dv
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Id_Maquina
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Rut_Titular
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Dv_Titular
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Forma_Pago
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Medio_Pago
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Codigo_Autorizacion
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Numero_Documento
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Numero_Cuenta
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Banco
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Fecha_Vencimiento
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Monto_Documento
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Monto_Forma_Pago
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Movimiento_Caja
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Tipo_Autorizacion
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Cantidad_Cuotas
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Interes
                                                               ,0)
                                                           ,2));
      IF Nvl(Utl_Raw.Length(p_Trama_Fp(l_Item).Banda_Magnetica)
            ,0) = 0 THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Lpad(' '
                                                             ,50
                                                             ,' ')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Overlay(p_Trama_Fp(l_Item).Banda_Magnetica
                                                    ,Utl_Raw.Cast_To_Raw(Lpad(' '
                                                                             ,50
                                                                             ,' '))
                                                    ,1));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Codigo_Servicio
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Local
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Numero_Pos
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Destino
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Sistema
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Funcion
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Secuencia_c
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Fecha_Transaccion
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Correlativo
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Numero_Trama
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Codigo_Transaccion
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Secuencia_Pago
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Meses_Diferido
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Tipo_Cuotas
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Numero_Tx_Comercio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Id_Transaccion
                                                                       ,' ')
                                                                   ,26
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Valor_Cuota
                                                               ,0)
                                                           ,8));
      -- IF Nvl(p_Version
      --       ,'POS') IN ('MAG') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Modo_Ingreso_Tarjeta
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      -- END IF;
      -- IF Nvl(p_Version
      --       ,'POS') IN ('FJC'
      --                  ,'PRE'
      --                  ,'MAG'
      --                  ,'FFR'
      --                  ,'SGN') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Flujo_Caja
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      -- END IF;
      -- IF Nvl(p_Version
      --       ,'POS') IN ('EC1') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Cliente_Tarjeta
                                                                       ,' ')
                                                                   ,100
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Telefono_Cliente
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Celular_Cliente
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Direccion_Cliente
                                                                       ,' ')
                                                                   ,100
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Genero
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp(l_Item).Nacimiento
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      -- END IF;
    
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp(l_Item).Documentos_a_Cancelar
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Fp1(p_Trama_Fp(l_Item).Subtrama_Fp1));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'FP';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Fp1(p_Trama_Fp1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Fp1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Fp1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Fp1(l_Item).Correlativo_Tx
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Fp1(l_Item).Tipo_Tx
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Tx(p_Trama_Tx IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Tx) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Tx.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Codigo_Servicio
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Codigo_Servicio
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tx(l_Item).Tx
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Timespan
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Tx(l_Item).Timespan
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Respuesta
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Respuesta
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_No_Enrutada
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_No_Enrutada
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_No_Existe
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_No_Existe
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Timeout
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Timeout
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Erronea
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Erronea
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Expirada
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Expirada
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Online
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Online
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Confirmada
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Confirmada
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Tx(l_Item).Tx_Nack
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Tx(l_Item).Tx_Nack
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'TX';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rx(p_Trama_Rx IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rx) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rx.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Codigo_Servicio
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Codigo_Servicio
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rx(l_Item).Rx
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Timespan
                                ,0));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rx(l_Item).Timespan
                                                                ,0)
                                                            ,l_Largo));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Ack
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Ack
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Nack
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Nack
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Con_Servicio
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Con_Servicio
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Sin_Servicio
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Sin_Servicio
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Timeout
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Timeout
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Rx(l_Item).Rx_Erronea
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rx(l_Item).Rx_Erronea
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'RX';
    l_Trama_Htx.Modo_Largo_Campos  := 'V';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  -- ============================================================
  -- DESARROLLO CUENTA CORRIENTE RECETA (CGC 16-12-2015)
  -- ============================================================
  FUNCTION Arma_Trama_Rp(p_Trama_Rp IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rp
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rp.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
    
      IF Nvl(p_Version
            ,'POS') IN ('CCR'
                       ,'ISP'
                       ,'COR'
                       ,'SQF'
                       ,'CCV'
                       ,'SPA'
                       ,'BIO'
                       ,'GLO'
                       ,'BOX'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        --erika 29112018
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Id_Receta
                                                                 ,0)
                                                             ,3));
                                                             --,128));
                                                             
        -- l_Registro := Utl_Raw.Concat(l_Registro
        --                            ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Id_Receta
        --                                                                 ,' ')
        --                                                             ,128
        --                                                             ,' ')
        --                                                        ,'WE8MSWIN1252')));
                                                             
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Local_Origen
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Fecha_Emision
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Convenio
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Plan
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Estado_Receta
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Serie
                                                                         ,' ')
                                                                     ,4
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Folio
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Despacho_Anticipado
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Fecha_Ingreso
                                                                 ,0)
                                                             ,8));
        --//--------------------------------------------------------------------------\\
        IF Nvl(p_Version
              ,'POS') IN ('DEC'
                         ,'ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Identi_Vendedor
                                                                           ,' ')
                                                                       ,30
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        ELSE
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Vendedor
                                                                   ,0)
                                                               ,4));
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Vendedor
                                                                           ,' ')
                                                                       ,1
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        END IF;
      
        IF Nvl(p_Version
              ,'POS') IN ('DEC'
                         ,'ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Identi_Cliente
                                                                           ,' ')
                                                                       ,30
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        ELSE
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Cliente
                                                                   ,0)
                                                               ,4));
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Cliente
                                                                           ,' ')
                                                                       ,1
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        END IF;
        --//--------------------------------------------------------------------------\\
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Nombre_Cliente
                                                                         ,' ')
                                                                     ,60
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      
        IF Nvl(p_Version
              ,'POS') IN ('DEC'
                         ,'ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Identi_Paciente
                                                                           ,' ')
                                                                       ,30
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        ELSE
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Paciente
                                                                   ,0)
                                                               ,4));
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Paciente
                                                                           ,' ')
                                                                       ,1
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        END IF;
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Nombre_Paciente
                                                                         ,' ')
                                                                     ,60
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Telefono
                                                                         ,' ')
                                                                     ,30
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        IF Nvl(p_Version
              ,'POS') IN ('DEC'
                         ,'ABF'
                         ,'ADR'
                         ,'PEX'
                         ,'EC1'
                         ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                         ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                         ,'NEU','ONS' ,'OBE' --JAGC 20261022
                         ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                         ,'SAM') THEN
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Identi_Medico
                                                                           ,' ')
                                                                       ,30
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        ELSE
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Medico
                                                                   ,0)
                                                               ,4));
          l_Registro := Utl_Raw.Concat(l_Registro
                                      ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Medico
                                                                           ,' ')
                                                                       ,1
                                                                       ,' ')
                                                                  ,'WE8MSWIN1252')));
        END IF;
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Nombre_Medico
                                                                         ,' ')
                                                                     ,60
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Serie
                                                                         ,' ')
                                                                     ,4
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Secuencia_Receta
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Medico
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Rut_Medico
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Nombre_Medico
                                                                         ,' ')
                                                                     ,20
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Emision
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Diagnostico
                                                                         ,' ')
                                                                     ,15
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Tipo_Receta
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Con_Copia
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Folio_Receta
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Tipo_Medicamento
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Paciente
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Paciente
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Nombre_Paciente
                                                                         ,' ')
                                                                     ,60
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Fecha_Ingreso_Paciente
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Fono_Paciente
                                                                         ,' ')
                                                                     ,15
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Convenio
                                                                 ,0)
                                                             ,8));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Plan
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Rut_Institucion
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp(l_Item).Dv_Institucion
                                                                         ,' ')
                                                                     ,1
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Lista_Productos
                                                               ,0)
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Rp1(p_Trama_Rp(l_Item).Subtrama_Rp1
                                                 ,p_Version));
    
      IF Nvl(p_Version
            ,'POS') IN ('CCR'
                       ,'ISP'
                       ,'COR'
                       ,'SQF'
                       ,'CCV'
                       ,'SPA'
                       ,'BIO'
                       ,'GLO'
                       ,'BOX'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        -- erika 29112018
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp(l_Item).Historial_Productos
                                                                 ,0)
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Arma_Trama_Rp2(p_Trama_Rp(l_Item).Subtrama_Rp2
                                                   ,p_Version));
      END IF;
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'RP';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rp1(p_Trama_Rp1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rp1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rp1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      IF Nvl(p_Version
            ,'POS') IN ('CCR'
                       ,'ISP'
                       ,'COR'
                       ,'SQF'
                       ,'CCV'
                       ,'SPA'
                       ,'BIO'
                       ,'GLO'
                       ,'BOX'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'ABF'
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        --erika 29112018
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Producto
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Dosis
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Veces
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Dias
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Estado_Producto
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Permanente
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Indicaciones
                                                                         ,' ')
                                                                     ,200
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Retiro_Anticipado
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Retiro_Actual
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Total_Retiros
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Fecha_Proximo_Retiro
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Fecha_Termino_Tratamiento
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad_Despacho_Anterior
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad_Despacho_Total
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad_Pendiente
                                                                 ,0)
                                                             ,4));
      ELSE
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Producto
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Cantidad_Pendiente
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Dosis
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Veces
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp1(l_Item).Dias
                                                                 ,0)
                                                             ,2));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Inscribir_En_Refill
                                                                         ,' ')
                                                                     ,2
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Texto
                                                                         ,' ')
                                                                     ,100
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rp1(l_Item).Forma_Farmaceutica
                                                                         ,' ')
                                                                     ,3
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rp2(p_Trama_Rp2 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rp2
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rp2.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Numero_Retiro
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Total_Retiros
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Folio_Documento
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Fecha_Documento
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rp2(l_Item).Cantidad
                                                                ,0)
                                                            ,4));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Ri(p_Trama_Ri IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ri
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
  BEGIN
    l_Registro := NULL;
    --l_Registro := Utl_Raw.Concat(l_Registro
    --                            ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Id_Receta
    --                                                         ,0)
    --                                                     --,3));
    --                                                     ,128));
    l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Id_Receta
                                                                       ,' ')
                                                                   ,128
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                         
    IF Nvl(p_Version
          ,'POS') IN ('CCR'
                     ,'ISP'
                     ,'SQF'
                     ,'CCV'
                     ,'BOX'
                     ,'GLO'
                     ,'FEL'
                     ,'FAT'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'VCO') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Copia_Verde
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    --l_Registro                     := Utl_Raw.Concat(l_Registro
    --                                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Secuencia_Receta
    --                                                                             ,0)
    --                                                                         --,8));
    --                                                                         ,128));
    l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Secuencia_Receta
                                                                       ,' ')
                                                                   ,128
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Serie
                                                                                         ,' ')
                                                                                     ,4
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Folio
                                                                                 ,0)
                                                                             ,8));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Fecha_Emision
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Rut_Cliente
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Dv_Cliente
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Nombre_Cliente
                                                                                         ,' ')
                                                                                     ,60
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Rut_Paciente
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Dv_Paciente
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Nombre_Paciente
                                                                                         ,' ')
                                                                                     ,60
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Telefono
                                                                                         ,' ')
                                                                                     ,30
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Rut_Medico
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Dv_Medico
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Nombre_Medico
                                                                                         ,' ')
                                                                                     ,60
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Rut_Institucion
                                                                                 ,0)
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Dv_Institucion
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri.Nombre_Institucion
                                                                                         ,' ')
                                                                                     ,30
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri.Lista_Productos
                                                                                 ,0)
                                                                             ,1));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Arma_Trama_Ri1(p_Trama_Ri.Subtrama_Ri1
                                                                   ,p_Version));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'RI';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ri1(p_Trama_Ri1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ri1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ri1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Cantidad
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Dosis
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Veces
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Dias
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri1(l_Item).Permanente
                                                                        ,' ')
                                                                    ,2
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ri1(l_Item).Indicaciones
                                                                        ,' ')
                                                                    ,200
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ri1(l_Item).Retiro
                                                                ,0)
                                                            ,2));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Rv(p_Trama_Rv IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Rv
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Rv.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rv(l_Item).Id_Receta
                                                               ,0)
                                                           --,3));
                                                           ,128));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rv(l_Item).Convenio
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rv(l_Item).Plan
                                                               ,0)
                                                           ,4));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Rv(l_Item).Folio
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      --      l_Registro  := Utl_Raw.Concat(l_Registro
      --                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rv(l_Item).Folio
      --                                                                ,0)
      --                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Rv(l_Item).Lista_Productos
                                                                ,0)
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Rv1(p_Trama_Rv(l_Item).Subtrama_Rv1
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'RV';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

