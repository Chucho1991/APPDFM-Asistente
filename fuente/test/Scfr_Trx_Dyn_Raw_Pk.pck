  FUNCTION Arma_Trama_Ns(p_Trama_Ns IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ns
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ns.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      IF p_Version = 'NRB' THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ns(l_Item).Trace
                                                                 ,0)
                                                             ,13));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ns(l_Item).Correlativo_Tx
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Tipo_Tx
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ns(l_Item).Fecha_Hora_Validacion
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ns(l_Item).Rut_Cliente
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Dv_Rut_Cliente
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Validacion_Biometria
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Codigo_Validacion_Biometria
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Descrip_Validacion_Biometria
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Validacion_Nro_Serie_Cedula
                                                                       ,' ')
                                                                   ,2
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF p_Version = 'NRB' THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Serie_Dcto_Ingresado
                                                                         ,' ')
                                                                     ,15
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Codigo_Validacion_Serie_Cedula
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Descrip_Validacion_Cedula
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Resultado_Firma_Electronica
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Mensaje_Firma_Electronica
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF p_Version = 'NRB' THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Json_Utilizado
                                                                         ,' ')
                                                                     ,800
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Codigo_Dec
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Resultado_Digitalizacion
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ns(l_Item).Documentos_Postergados
                                                                        ,' ')
                                                                    ,20
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ns(l_Item).Ticket_Postergacion_Digital
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'NS';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;
  FUNCTION Arma_Trama_Vz(p_Trama_Vz IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Vz) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Vz.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vz(l_Item).Tipo_Retencion
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vz(l_Item).Numero_Factura
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vz(l_Item).Numero_Retencion
                                                               ,0)
                                                           ,8));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vz(l_Item).Monto
                                                               ,0)
                                                           ,8));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vz(l_Item).Decimal_Monto
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vz(l_Item).Fecha_Retencion
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vz(l_Item).Retencion_Pagada
                                                                        ,' ')
                                                                    ,2
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'VZ';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;
  
  --INI JAGC 20240909 NECESIDADES 'NEC'                               
  -------------------------------------------------------------------------
  --Trama IN 2024 JAGC Producto Inscrito a Necesidad
  -------------------------------------------------------------------------  
  FUNCTION Arma_Trama_In(p_Trama_In IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_In
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Largo     NUMBER;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_In.Count;
    FOR l_Item IN 1 .. l_Tot_Reg    
    LOOP    
      
      l_Registro := NULL;
    

      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_In(l_Item).Codigo_Producto
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).unidadesAcumuladasCtaCte
                                                               ,0)
                                                           ,2));     
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).montoProximoDescuento
                                                               ,0)
                                                           ,8));   
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_In(l_Item).tipoProximoDescuento
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252'))); 
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).unidadesAcumuladasMensuales
                                                               ,0)
                                                           ,2));   
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).fechaInscripcion
                                                               ,0)
                                                           ,4));   
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).limiteUnidadesTx
                                                               ,0)
                                                           ,2));   
                                                           
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).Limiteunidadesmensuales
                                                               ,0)
                                                           ,2));  
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).fechaExpiracionProducto
                                                               ,0)
                                                           ,4));           
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_In(l_Item).estado
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));    
                                                           
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_In(l_Item).idNecesidad
                                                               ,0)
                                                           ,4));      
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_In(l_Item).descripcionNecesidad
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));   
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_In(l_Item).nombreNecesidad
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));                                                                                                   
                                                              
     
                                   
      l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);      
      
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
                                   
    END LOOP;
    
    l_Trama_Htx.Tipo_Informacion   := 'NI';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;    
  END;
  
  -------------------------------------------------------------------------
  --Trama IB 2024 JAGC Inscripci?n Producto a Beneficio Necesidad
  -------------------------------------------------------------------------  
  FUNCTION Arma_Trama_Ib(p_Trama_Ib IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Ib
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Respuesta BLOB;
    l_Largo     NUMBER;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Ib.Count;

    FOR l_Item IN 1 .. l_Tot_Reg    
    LOOP   
        
      l_Registro := NULL;
                                                              
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ib(l_Item).idNecesidad
                                                               ,0)
                                                           ,4));     
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ib(l_Item).Codigo_Producto
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Ib(l_Item).FechaHoraInscripcion
                                                               ,0)
                                                           ,8));     
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ib(l_Item).IdVendedor
                                                                       ,' ')
                                                                   ,10
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ib(l_Item).NombreVendedor
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Ib(l_Item).Canal
                                                                       ,' ')
                                                                   ,3
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
     
                                   
      l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);     
      
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);  
    
                                   
    END LOOP;                   
      
    l_Trama_Htx.Tipo_Informacion   := 'IB';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;      
  END;
  --FIN JAGC 20240909 NECESIDADES 'NEC'

END Scfr_Trx_Dyn_Raw_Pk;
/
