      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp.Institucion_Salud
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
  
    IF Nvl(p_Version
          ,'POS') IN ('BOX'
                     ,'GLO'
                     ,'FEL'
                     ,'FAT'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Monto_Acumulado_Club
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp.Monto_Acumulado_Club
                                                               ,0)
                                                           ,l_Largo));
    END IF;
    --//--------------------------------------------------------------------------\\
    --// CBR 12/08/2020 02:01                                                     \\
    --// Desarrollo para resolutor Ecuador                                        \\
    --// con nuevo origen transaccion 'DEC'                                       \\
    --//-----------------------------------------------------------------Inicio---\\
  
    IF Nvl(p_Version
          ,'POS') IN ('DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'ADR'
                     ,'PEX'
                     ,'EC1'
                     ,'RYT'
                     ,'SAM'
                     ,'VCO'
                     ,'DON'
                     ,'MOP') THEN
    
      l_Largo    := Lengthb(Nvl(p_Trama_Dp.Decimal_Acum_Club
                               ,'0'));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
