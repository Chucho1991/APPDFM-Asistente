      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Po1(p_Trama_Po(l_Item).Subtrama_Po1));
    
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
