                                                                ,0)
                                                            ,6));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pq(l_Item).Porcentaje_Bonif_Informado
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
