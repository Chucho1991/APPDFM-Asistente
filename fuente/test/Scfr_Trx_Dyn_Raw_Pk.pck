  FUNCTION Arma_Trama_Co2(p_Trama_Co2 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Co2
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Co2.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Largo    := Lengthb(Nvl(p_Trama_Co2(l_Item).Identi_Titular_Benefic
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co2(l_Item).Identi_Titular_Benefic
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Largo    := Lengthb(Nvl(p_Trama_Co2(l_Item).Codigo_Preexistencia
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co2(l_Item).Codigo_Preexistencia
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Largo     := Lengthb(Nvl(p_Trama_Co2(l_Item).Mensaje_Preexistencia
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co2(l_Item).Mensaje_Preexistencia
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Co1(p_Trama_Co1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Co1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Co1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      --//--------------------------------------------------------------------------\\
      --// CBR 17/08/2020 00:53                                                     \\
      --// Desarrollos para resolutor Ecuador con nuevo origen transaccion 'DEC'    \\
      --//-----------------------------------------------------------------Inicio---\\
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('DEC'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Identi_Titular_Benefic
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Identi_Titular_Benefic
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Rut_Titular_Beneficiario
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co1(l_Item).Rut_Titular_Beneficiario
                                                                 ,0)
                                                             ,l_Largo));
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Digito_Verificador_Rut
                                 ,' '));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Digito_Verificador_Rut
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      --//-----------------------------------------------------------------Termino--\\
      IF p_Version IN ('SAM','SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
        ) THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Party_Id_Cliente_c
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Party_Id_Cliente_c
                                                                         ,' ')
                                                                     ,l_Largo
                                                                     ,' ')
                                                                ,'WE8MSWIN1252')));
      ELSE
      
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Party_Id_Cliente
                                 ,0));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co1(l_Item).Party_Id_Cliente
                                                                 ,0)
                                                             ,l_Largo));
      END IF;
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Secuencia_Titular_Beneficiario
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co1(l_Item).Secuencia_Titular_Beneficiario
                                                               ,0)
                                                           ,l_Largo));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Apellido_Paterno
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Apellido_Paterno
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Apellido_Materno
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Apellido_Materno
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Nombres
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Nombres
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Estado_Beneficiario
                               ,' '));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Estado_Beneficiario
                                                                       ,' ')
                                                                   ,l_Largo
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Saldo
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co1(l_Item).Saldo
                                                               ,0)
                                                           ,l_Largo));
      l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Saldo_Segundo_Credito
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Co1(l_Item).Saldo_Segundo_Credito
                                                               ,0)
                                                           ,l_Largo));
      --//--------------------------------------------------------------------------\\
      --// CBR 11/10/2017 17:06                                                     \\
      --// BIOMETRIA                                                                \\
      --//-----------------------------------------------------------------Inicio---\\
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('BIO'
                       ,'GLO'
                        --                     ,'BOX'
                       ,'FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'CPE'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Biometria
                                 ,'NO'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Biometria
                                                                         ,'NO')
                                                                     ,l_Largo
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Clave_Qf_Biometria
                                 ,'NO'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Clave_Qf_Biometria
                                                                         ,'NO')
                                                                     ,l_Largo
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
      END IF;
      --//-----------------------------------------------------------------Termino--\\
      /* CGC 25-10-2018 INI */
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('FEL'
                       ,'FAT'
                       ,'CIA'
                       ,'EMP'
                       ,'DEC'
                       ,'CPE'
                       ,'ABF'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'ADR'
                       ,'PEX'
                       ,'EC1'
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Huella_Qf_Biometria
                                 ,'NO'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Huella_Qf_Biometria
                                                                         ,'NO')
                                                                     ,l_Largo
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Firma_Electronica
                                 ,'NO'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Firma_Electronica
                                                                         ,'NO')
                                                                     ,l_Largo
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
      
      END IF;
      -------------------------------------------------------------
      -- LMP 2023 GPF Agregado c?digo para origen tx 'SAL'
      -------------------------------------------------------------
      IF Nvl(p_Version
            ,'POS') IN ('PEX'
                       ,'EC1'
                       ,'SAL'
                       ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                       ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                       ,'NEU','ONS' ,'OBE' --JAGC 20261022
                       ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                       ,'SAM') THEN
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Mensaje_Beneficiario
                                 ,'NO'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Mensaje_Beneficiario
                                                                         ,'NO')
                                                                     ,l_Largo
                                                                     ,'  ')
                                                                ,'WE8MSWIN1252')));
      
        l_Largo    := Lengthb(Nvl(p_Trama_Co1(l_Item).Saldo_Decimal
                                 ,'0'));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                             ,1));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Co1(l_Item).Saldo_Decimal
                                                                         ,'0')
                                                                     ,l_Largo
                                                                     ,'0')
                                                                ,'WE8MSWIN1252')));
      END IF;
      /* CGC 25-10-2018 FIN */
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Cr(p_Trama_Cr IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Cr) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Cr.Rut_Quien_Retira
                                                                                 ,0)
                                                                             ,10));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cr.Dv_Rut_Quien_Retira
                                                                                         ,' ')
                                                                                     ,1
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Cr.Nombre_Quien_Retiro
                                                                                         ,' ')
                                                                                     ,20
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'CR';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

