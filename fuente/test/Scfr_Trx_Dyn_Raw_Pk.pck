  FUNCTION Arma_Trama_Oc(p_Trama_Oc IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Oc
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    -- IF Nvl(p_Version,'POS') IN ('OTN','SAP') THEN
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Oc.Numero_Orden_Trabajo
                                                                     ,' ')
                                                                 ,14
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    -- ELSE
    --   l_Registro := Utl_Raw.Concat(l_Registro,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Oc.Numero_Orden_Trabajo,' '),13,' '),'WE8MSWIN1252')));
    -- END IF;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Oc.Fecha_Hasta
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Oc.Valor_Total
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Oc.Local_Recetario
                                                             ,0)
                                                         ,4));
    IF Nvl(p_Version
          ,'POS') IN ('SAP') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Oc.Fecha_Compromiso
                                                               ,0)
                                                           ,6));
    END IF;
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'OC';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

