  FUNCTION Arma_Trama_Sc1(p_Trama_Sc1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Sc1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Sc1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Codigo_Producto_Interno
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Familia_Comercial
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Tope
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Cantidad
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Fecha_Transaccion
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Convenio_Compra_Frecuente
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Fecha_Expiracion
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Sc1(l_Item).Glosa_Reclamo
                                                                        ,' ')
                                                                    ,30
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Sc1(l_Item).Porcentaje_Descuento
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Sc1(l_Item).Signo
                                                                        ,' ')
                                                                    ,1
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Sc1(l_Item).Cantidad_Eventos_Beneficio
                                                                ,0)
                                                            ,1));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

