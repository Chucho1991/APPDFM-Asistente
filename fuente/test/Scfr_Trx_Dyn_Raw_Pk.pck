                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Fecha_Actualizacion
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp2(l_Item).Fecha_Actualizacion
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Habilitado
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp2(l_Item).Habilitado
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Largo     := Lengthb(Nvl(p_Trama_Dp2(l_Item).Eliminado
                                ,' '));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                            ,1));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Dp2(l_Item).Eliminado
                                                                        ,' ')
                                                                    ,l_Largo
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Dp3(p_Trama_Dp3 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Dp3) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Item2     NUMBER;
    l_Tot_Reg   NUMBER;
    l_Tot_Reg2  NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Dp3.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Largo    := Lengthb(Nvl(p_Trama_Dp3(l_Item).Id_Pro
                               ,0));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                           ,1));
