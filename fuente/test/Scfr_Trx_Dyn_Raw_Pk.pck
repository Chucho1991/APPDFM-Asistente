  FUNCTION Arma_Trama_Pg1(p_Trama_Pg1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pg1) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pg1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pg1(l_Item).Folio
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pg1(l_Item).Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pg1(l_Item).Uso_Frecuente
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pg1(l_Item).Cantidad_Acumulada_Psalud
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pg1(l_Item).Cantidad
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pg1(l_Item).Porcentaje_Descuento
                                                                        ,' ')
                                                                    ,6
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pg1(l_Item).Detalle_Descuento_Producto
                                                                        ,' ')
                                                                    ,250
                                                                    ,' ')
                                                               ,'WE8MSWIN1252')));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;
  -----------------------------------------------------
  FUNCTION Arma_Trama_Gp1(p_Trama_Gp1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Gp1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Gp1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro  := NULL;
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp1(l_Item).Codigo_Producto
                                                                ,0)
                                                            ,4));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp1(l_Item).Cantidad
                                                                ,0)
                                                            ,2));
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  FUNCTION Arma_Trama_Gp(p_Trama_Gp IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Gp
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
    l_Tot_Per   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Gp.Count;
  
    BEGIN
      SELECT Rv_Low_Value INTO l_Tot_Per FROM Fid.Cg_Ref_Codes WHERE Rv_Domain = 'REGISTROS_EXCC09';
    EXCEPTION
      WHEN OTHERS THEN
        l_Tot_Per := 25;
    END;
  
    IF (l_Tot_Reg > l_Tot_Per) THEN
      l_Tot_Reg := l_Tot_Per;
    END IF;
  
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Fecha_Hora_Emision
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Local_Origen
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gp(l_Item).Nombre_Origen
                                                                       ,' ')
                                                                   ,100
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Local_Destino
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gp(l_Item).Nombre_Destino
                                                                       ,' ')
                                                                   ,100
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gp(l_Item).Folio
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Gp(l_Item).Guia_Despacho
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Fecha_Hora_Traspaso
                                                               ,0)
                                                           ,4));
    
      IF Nvl(p_Version
            ,'POS') IN ('TRA'            
                       ,'FGI' --JAGC 20250414 ORIGEN FGI
                       ) --JRC 27/04/2023 Agrego 'TRA'
       THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Cantidad_Productos_Traspaso
                                                                 ,0)
                                                             ,2));
      END IF;
    
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Gp(l_Item).Cantidad_Productos
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Gp1(p_Trama_Gp(l_Item).Subtrama_Gp1
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
  
    l_Trama_Htx.Tipo_Informacion   := 'GP';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;
  -----------------------------------------------------

  -- JRC 19/12/2019 Corresponde al agregar a la trama el campo Motivo.
  FUNCTION Arma_Trama_Pi(p_Trama_Pi IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pi
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
    l_Tot_Per   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pi.Count;
  
    BEGIN
      SELECT Rv_Low_Value INTO l_Tot_Per FROM Fid.Cg_Ref_Codes WHERE Rv_Domain = 'REGISTROS_EXCC06';
    
    EXCEPTION
      WHEN OTHERS THEN
        l_Tot_Per := 25;
    END;
  
    IF (l_Tot_Reg > l_Tot_Per) THEN
      l_Tot_Reg := l_Tot_Per;
    END IF;
  
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Tipo_Movimiento_Padre
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Tipo_Movimiento_Hijo
                                                                       ,' ')
                                                                   ,6
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Folio
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Guia_Despacho
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Tipo_Guia_Despacho
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Accion_Sobre_Existencia
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Numero_Folio_Original
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      -- l_Registro := Utl_Raw.Concat(l_Registro
      -- ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Numero_Folio_Original
      -- ,0)
      -- ,8));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Fecha_Folio_Original
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Ot
                                                                       ,' ')
                                                                   ,14
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Valor_Recetario
                                                               ,0)
                                                           ,8));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Decimal_Valor_Recetario
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      -- JRC 19/12/2019 Se agrega campo Motivo
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Motivo
                                                                       ,' ')
                                                                   ,250
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Tipo_Negocio
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Tipo_Transferencia
                                                                       ,' ')
                                                                   ,1
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Idtransportista
                                                                       ,' ')
                                                                   ,16
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Nombre_Transportista
                                                                       ,' ')
                                                                   ,150
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Placa_Transportista
                                                                       ,' ')
                                                                   ,16
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Clave_Acceso
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Serie
                                                               ,0)
                                                           ,6));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Comprobante
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Codigo_Numerico
                                                               ,0)
                                                           ,8));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Numero_Resolucion
                                                                       ,' ')
                                                                   ,15
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Agente_Retencion
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).Microempresa
                                                                       ,' ')
                                                                   ,50
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('ERP'
                       ,'TRA' --JRC 27/04/2023 Agrego 'TRA'
                       ,'FGI' --JAGC 20250414 ORIGEN FGI
                       ,'SLV') -- IDHC ORIGEN SLV 
       THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Local_Origen
                                                                 ,0)
                                                             ,4));
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Local_Destino
                                                                 ,0)
                                                             ,4));
      END IF;
    
      --JRC 27/04/2023 Solo informa la cantidad de productos, no la SubTrama
      IF Nvl(p_Version
            ,'POS') IN ('TRA' --JRC 27/04/2023 Agrego 'TRA'
                       ,'FGI' --JAGC 20250414 ORIGEN FGI
                       ,'SLV')-- IDHC ORIGEN SLV 
       THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Cantidad_Productos_Traspaso
                                                                 ,0)
                                                             ,2));
      END IF;
      --
      
      --INI JAGC 20250414 ORIGEN FGI
      IF Nvl(p_Version
          ,'POS') IN ('FGI','SLV') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).DISPATCH_QR
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                              
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).CODIGO_DESPLAZAMIENTO
                                                                       ,' ')
                                                                   ,30
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
        
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).USUARIO_EMISOR
                                                                       ,' ')
                                                                   ,20
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
        -- IDHC 
        IF Nvl(p_Version,'POS') IN ('SLV') THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi(l_Item).OBSERVACION
                                                                       ,' ')
                                                                   ,250
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
                                                                      
        END IF;
      END IF;
      --FIN JAGC 20250414 ORIGEN FGI
      
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi(l_Item).Cantidad_Productos
                                                                ,0)
                                                            ,2));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Arma_Trama_Pi1(p_Trama_Pi(l_Item).Subtrama_Pi1
                                                  ,p_Version));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
  
    l_Trama_Htx.Tipo_Informacion   := 'PI';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;
  --

  FUNCTION Arma_Trama_Pi1(p_Trama_Pi1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Pi1
                         ,p_Version   IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
    l_Respuesta := NULL;
    l_Tot_Reg   := p_Trama_Pi1.Count;
    FOR l_Item IN 1 .. l_Tot_Reg
    LOOP
      l_Registro := NULL;
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi1(l_Item).Producto
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi1(l_Item).Cantidad
                                                               ,0)
                                                           ,2));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi1(l_Item).Costo_Unitario
                                                               ,0)
                                                           ,4));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi1(l_Item).Decimal_Cunitario
                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi1(l_Item).Lote
                                                                       ,' ')
                                                                   ,150
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
      IF Nvl(p_Version
            ,'POS') IN ('ERP'
                       ,'TRA' --JRC 28/04/2023 Agrego TRA
                       ,'FGI' --JAGC 20250414 ORIGEN FGI
                       ,'SLV') -- IDHC 20260623 ORIGEN SLV
       THEN
        l_Registro := Utl_Raw.Concat(l_Registro
                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi1(l_Item).Fecha_Vencimiento
                                                                 ,0)
                                                             ,4));
      END IF;
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

  -- JRC 19/12/2019 Corresponde al agregar a la trama el campo Motivo.
  FUNCTION Arma_Trama_Pi(p_Trama_Pi IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Pi
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
    l_Respuesta BLOB;
    l_Item      NUMBER;
    l_Tot_Reg   NUMBER;
  BEGIN
  
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Tipo_Movimiento_Padre
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Tipo_Movimiento_Hijo
                                                                     ,' ')
                                                                 ,6
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Folio
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Guia_Despacho
                                                                     ,' ')
                                                                 ,30
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Tipo_Guia_Despacho
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Accion_Sobre_Existencia
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Numero_Folio_Original
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Fecha_Folio_Original
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Ot
                                                                     ,' ')
                                                                 ,14
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Valor_Recetario
                                                             ,0)
                                                         ,8));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Decimal_Valor_Recetario
                                                                     ,' ')
                                                                 ,4
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    -- JRC 19/12/2019 Se agrega campo Motivo
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Motivo
                                                                     ,' ')
                                                                 ,250
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Tipo_Negocio
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Tipo_Transferencia
                                                                     ,' ')
                                                                 ,1
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Idtransportista
                                                                     ,' ')
                                                                 ,16
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Nombre_Transportista
                                                                     ,' ')
                                                                 ,150
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Placa_Transportista
                                                                     ,' ')
                                                                 ,16
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Clave_Acceso
                                                                     ,' ')
                                                                 ,50
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Serie
                                                             ,0)
                                                         ,6));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Comprobante
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Codigo_Numerico
                                                             ,0)
                                                         ,8));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Numero_Resolucion
                                                                     ,' ')
                                                                 ,15
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Agente_Retencion
                                                                     ,' ')
                                                                 ,50
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.Microempresa
                                                                     ,' ')
                                                                 ,50
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    IF Nvl(p_Version
          ,'POS') IN ('ERP'
                     ,'TRA' --JRC 27/04/2023 Agrego 'TRA'
                     ,'FGI' --JAGC 20250414 ORIGEN FGI
                     ,'SLV')-- IDHC ORIGEN SLV 
     THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Local_Origen
                                                               ,0)
                                                           ,4));
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Local_Destino
                                                               ,0)
                                                           ,4));
    END IF;
    --JRC 27/04/2023 Solo informa la cantidad de productos, no la SubTrama
    IF Nvl(p_Version
          ,'POS') IN ('TRA' --JRC 27/04/2023 Agrego 'TRA'
                     ,'FGI' --JAGC 20250414 ORIGEN FGI
                     ,'SLV') -- IDHC ORIGEN SLV 
     THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Cantidad_Productos_Traspaso
                                                               ,0)
                                                           ,2));
      --
    END IF;
    
    --INI JAGC 20250414 ORIGEN FGI
    IF Nvl(p_Version
        ,'POS') IN ('FGI','SLV') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.DISPATCH_QR
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
                                                            
      l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.CODIGO_DESPLAZAMIENTO
                                                                     ,' ')
                                                                 ,30
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
      
      l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.USUARIO_EMISOR
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
      -- IDHC 
        l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Pi.OBSERVACION
                                                                       ,' ')
                                                                   ,250
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));
    END IF;
    --FIN JAGC 20250414 ORIGEN FGI  
  
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pi.Cantidad_Productos
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Arma_Trama_Pi1(p_Trama_Pi.Subtrama_Pi1
                                               ,p_Version));
    l_Registro := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                         ,2)
                                ,l_Registro);
  
    l_Trama_Htx.Tipo_Informacion   := 'PI';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  
  END;

  FUNCTION Arma_Trama_Pp(p_Trama_Pp IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Pp) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Largo                        := Lengthb(Nvl(p_Trama_Pp.Fecha
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,4));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pp.Fecha
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Largo                        := Lengthb(Nvl(p_Trama_Pp.Puntos
                                                 ,0));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(l_Largo
                                                                             ,3));
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pp.Puntos
                                                                                 ,0)
                                                                             ,l_Largo));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'PP';
    l_Trama_Htx.Modo_Largo_Campos  := '';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Ps(p_Trama_Ps IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Ps) RETURN BLOB IS
