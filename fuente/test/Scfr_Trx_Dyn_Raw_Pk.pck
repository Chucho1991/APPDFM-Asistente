      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pq(l_Item).Deducible_Aplicado_En_Pesos
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(l_Registro
                                   ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Pq(l_Item).Tope_Aplicado_En_Pesos
                                                                ,0)
                                                            ,8));
      l_Registro  := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                            ,2)
                                   ,l_Registro);
      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    l_Trama_Htx.Tipo_Informacion   := 'PQ';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Respuesta);
    l_Trama_Htx.Cantidad_Registros := l_Tot_Reg;
    l_Respuesta                    := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Respuesta);
    RETURN l_Respuesta;
  END;

  -- cnvc02
  -- cnvc03
  FUNCTION Arma_Trama_Av(p_Trama_Av IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Av) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro                     := NULL;
    l_Registro                     := Utl_Raw.Concat(l_Registro
                                                    ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Av.Codigo_Autorizacion
                                                                                         ,' ')
                                                                                     ,20
                                                                                     ,' ')
                                                                                ,'WE8MSWIN1252')));
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'AV';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  -- cnvc04
  FUNCTION Arma_Trama_Vr(p_Trama_Vr IN Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Vr
                        ,p_Version  IN VARCHAR2 DEFAULT NULL) RETURN BLOB IS
    l_Trama_Htx Scfr_Trx_Dyn_Types_Pk.Rec_Trama_Htx;
    l_Registro  BLOB;
    l_Largo     NUMBER;
  BEGIN
    l_Registro := NULL;
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vr.Codigo_Autorizacion
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Disponible
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Disponible_Copago
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vr.Codigo_Autorizacion_Externo
                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Interes
                                                             ,0)
                                                         ,2));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Vencimiento_Primera_Cuota
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Valor_Primera_Cuota
                                                             ,0)
                                                         ,4));
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Numero_Liquidacion
                                                             ,0)
                                                         ,8));
    IF Nvl(p_Version
          ,'POS') IN ('CCR'
                     ,'COR'
                     ,'SQF'
                     ,'CCV'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'ADR'
                     ,'PEX'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Id_Receta
                                                               ,0)
                                                           --,3));
                                                           ,128));
      --l_Registro := Utl_Raw.Concat(l_Registro
      --                              ,Utl_Raw.Cast_To_Raw(Convert(Rpad(Nvl(p_Trama_Vr.Id_Receta
      --                                                                   ,' ')
      --                                                               ,128
      --                                                               ,' ')
      --                                                          ,'WE8MSWIN1252')));

    END IF;
    IF Nvl(p_Version
          ,'POS') IN ('ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'ADR'
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
                     ,'NEC' -- JAGC 20240909 CAMBIO TRAMA POR ORIGEN NEC
                     ,'NEU','ONS' ,'OBE' --JAGC 20261022
                     ,'CON' -- JAGC 20240529 CAMBIO TRAMA POR ORIGEN CON
                     ,'PEX'
                     ,'EC1'
                     ,'SAM') THEN
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Vr.Cantidad_Producto
                                                               ,0)
                                                           ,2));
    
      l_Registro := Utl_Raw.Concat(l_Registro
                                  ,Arma_Trama_Vr1(p_Trama_Vr.Subtrama_Vr1));
    END IF;
  
    l_Registro                     := Utl_Raw.Concat(Scfr_Trx_Util_Pk.Num2bin(Utl_Raw.Length(l_Registro)
                                                                             ,2)
                                                    ,l_Registro);
    l_Trama_Htx.Tipo_Informacion   := 'VR';
    l_Trama_Htx.Modo_Largo_Campos  := 'F';
    l_Trama_Htx.Largo_Buffer_Datos := Dbms_Lob.Getlength(l_Registro);
    l_Trama_Htx.Cantidad_Registros := 1;
    l_Registro                     := Utl_Raw.Concat(Arma_Trama_Htx(l_Trama_Htx)
                                                    ,l_Registro);
    RETURN l_Registro;
  END;

  FUNCTION Arma_Trama_Vr1(p_Trama_Vr1 IN Scfr_Trx_Dyn_Types_Pk.Tab_Trama_Vr1) RETURN BLOB IS
    l_Registro  BLOB;
