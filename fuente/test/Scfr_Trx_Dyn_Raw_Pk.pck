                                                                     ,' ')
                                                                 ,20
                                                                 ,' ')
                                                            ,'WE8MSWIN1252')));
        
    --FIN JAGC 20250414 ORIGEN FGI  
                                                       
    l_Registro := Utl_Raw.Concat(l_Registro
                                ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Md.Numero_Pedido
                                                             ,0)
                                                         ,8));
