    IF Nvl(p_Version
          ,'POS') IN ('GLO'
                     ,'FEL'
                     ,'FAT'
                     ,'CIA'
                     ,'EMP'
                     ,'DEC'
                     ,'ABF'
                     ,'SAL' -- LMP 2023 GPF Ecuador
                     ,'MSP' -- JAGC 20230325 CAMBIO TRAMA POR ORIGEN MSP
