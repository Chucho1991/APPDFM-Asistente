                                                                       ,' ')
                                                                   ,4
                                                                   ,' ')
                                                              ,'WE8MSWIN1252')));                                    
    --FIN JAGC 20250414 ORIGEN FGI   

      l_Respuesta := Utl_Raw.Concat(l_Respuesta
                                   ,l_Registro);
    END LOOP;
    RETURN l_Respuesta;
  END;

