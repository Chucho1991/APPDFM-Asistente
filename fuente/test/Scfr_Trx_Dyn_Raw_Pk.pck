      --      l_Registro := Utl_Raw.Concat(l_Registro
      --                                  ,Scfr_Trx_Util_Pk.Num2bin(Nvl(p_Trama_Dp.Decimal_Acum_Club
      --                                                               ,0)
      --                                                           ,l_Largo));
    
      l_Registro := Utl_Raw.Concat(l_Registro
